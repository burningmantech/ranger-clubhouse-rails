<% review = Vc::ReviewStages.new(@application) %>
<% checks = application_checks(@application) %>

<%= hero_panel icon: "calendar", heading_level: :h1, id: "prospective-application", back_to: ["#{@application.year} Applications", vc_applications_path(year: @application.year)] do |panel| %>
  <% panel.title do %>
    Application <%= @application.application_id %> &mdash; <%= @application.first_name %> <%= @application.last_name %>
  <% end %>
  <% panel.description do %>
    <%= application_assignment_note(@application, current_user) %>
  <% end %>
<% end  %>

<%= render "action_bar", application: @application, review:, checks: %>

<div class="mt-3">
  <%= render "banners", application: @application, related_applications: @related_applications %>
</div>

<div class="lg:grid lg:grid-cols-[1fr_20rem] lg:gap-4 lg:items-start mt-3" data-controller="vc-stages">
  <div class="min-w-0">
    <% review.stages.each do |stage| %>
      <%= render layout: "stage_card", locals: { stage:, review: } do %>
        <% if stage.key == :decision %>
          <%= render "decision_stage", application: @application, review:, checks: %>
        <% else %>
          <%= render "#{stage.key}_stage", application: @application %>
        <% end %>
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= ui_accordion "Mail Log (#{@application.mail_logs.size})" do %>
        <%= render "mail_log_section", application: @application %>
      <% end %>

      <%= ui_accordion "Audit Log (#{@application.audit_logs.size})" do %>
        <%= render "audit_log_section", application: @application %>
      <% end %>

      <%= ui_accordion "Misc. & Admin" do %>
        <%= render "admin_section", application: @application %>
      <% end %>
    </div>
  </div>

  <div class="mt-4 lg:mt-0">
    <%= render "rail", application: @application, related_applications: @related_applications %>
  </div>
</div>

<div class="my-4">
  <%= back_to "#{@application.year} Applications", vc_applications_path(year: @application.year) %>
</div>

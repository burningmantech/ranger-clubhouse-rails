<%# One checked handle and the conflicts found for it, most serious first.
    grow/basis-xl: results sit side by side from 36rem each and wrap, as the
    Ember original did; min-w-0 lets a wide table scroll inside its own box
    instead of pushing the page sideways. %>
<article class="grow basis-xl min-w-0">
  <%= ui_subheading name %>
  <p class="mb-3">
    <%= handle_checker_result_summary(conflicts) %>
    <% if (note = handle_checker_overflow_note(conflicts)) %>
      <span class="text-sm text-stone-muted"><%= note %></span>
    <% end %>
  </p>

  <% if conflicts.any? %>
    <%# Not responsive: a card per conflict would be a hundred labelled cards for
        one handle, and the rule cell spans its run of rows, which per-row cards
        cannot show. On a phone the ledger scrolls inside its own box. %>
    <%= ui_table full_width: true, responsive: false, caption: "Conflicts for #{name}" do |t| %>
      <%= t.header do %>
        <%= t.heading "Conflict" %>
        <%= t.heading "Handle Type" %>
        <%= t.heading "Priority" %>
        <%= t.heading "Rule" %>
      <% end %>
      <%= t.body do %>
        <% handle_checker_rule_runs(conflicts).each do |conflict, rowspan| %>
          <%= t.row do %>
            <%= t.cell do %>
              <%= handle_checker_description(conflict) %>
              <% if conflict.conflicting_handle&.reason.present? %>
                <span class="block text-sm text-stone-muted">
                  Reason: <%= conflict.conflicting_handle.reason %>
                </span>
              <% end %>
            <% end %>
            <%= t.cell handle_checker_type_badges(conflict.conflicting_handle) %>
            <%= t.cell handle_checker_priority_text(conflict.priority) %>
            <% if rowspan %>
              <%= t.cell handle_checker_rule_name(conflict.rule_id), rowspan:,
                         class: "text-sm text-stone-muted border-s border-base-300" %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</article>

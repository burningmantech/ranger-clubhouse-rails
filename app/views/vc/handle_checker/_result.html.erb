<%# One checked handle and the conflicts found for it, one conflict per line. %>
<%= ui_accent_card name,
                   variant: handle_checker_result_variant(conflicts),
                   icon: handle_checker_result_icon(conflicts),
                   icon_type: :solid,
                   heading_level: :h3 do %>
  <p class="text-base text-body">
    <%= handle_checker_result_summary(conflicts) %>
  </p>

  <ul class="mt-3 flex flex-col gap-2">
    <% handle_checker_shown_conflicts(conflicts).each do |conflict| %>
      <li class="text-base text-body">
        <%= handle_checker_conflict_line(conflict) %>
        <% if conflict.conflicting_handle&.reason.present? %>
          <span class="block text-sm text-stone-muted">
            Reason: <%= conflict.conflicting_handle.reason %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if (note = handle_checker_overflow_note(conflicts)) %>
    <p class="mt-3 text-sm text-stone-muted"><%= note %></p>
  <% end %>
<% end %>

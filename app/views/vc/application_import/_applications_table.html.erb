<%#
  One table for both the new/imported and the existing application buckets.
  locals: applications (Array<ProspectiveApplication>), download (String — names
  the CSV download).

  The Clubhouse ID column only links saved records: preview rows have no id
  yet, and a rolled-back creation failure never reaches this partial.
%>
<%= ui_table do |t| %>
  <%= t.header do %>
    <%= t.heading "Clubhouse ID" %>
    <%= t.heading "Salesforce ID" %>
    <%= t.heading "Name" %>
    <%= t.heading "Email" %>
    <%= t.heading "Status" %>
  <% end %>
  <%= t.body do %>
    <% applications.each do |application| %>
      <%= t.row do %>
        <%= t.row_header do %>
          <% if application.persisted? %>
            <%= application_link(application) %>
          <% else %>
            &mdash;
          <% end %>
        <% end %>
        <%= t.cell application.salesforce_name %>
        <%= t.cell "#{application.first_name} #{application.last_name}".strip %>
        <%= t.cell email_link_or_dash(application.email) %>
        <%= t.cell do %>
          <%= application_status_badge(application.status) %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<div class="mt-3">
  <%= export_csv_link(applications_csv_data_uri(applications), "Download CSV",
                      download: "salesforce-#{download}.csv") %>
</div>

<%#
  One table for both failure buckets; renders nothing when the bucket is
  empty. locals: failures (Array<ProspectiveApplicationImport::Failure>),
  title, intro, id (String — also names the CSV download).
%>
<% if failures.any? %>
  <%= ui_section title, icon: "triangle-exclamation", icon_type: :solid, badge: failures.size.to_s, id: id do %>
    <p class="mb-3"><%= intro %></p>

    <%= ui_table do |t| %>
      <%= t.header do %>
        <%= t.heading "Salesforce ID" %>
        <%= t.heading "Name" %>
        <%= t.heading "Problem" %>
        <%= t.heading "Application Object ID" %>
        <%= t.heading "Contact Object ID" %>
      <% end %>
      <%= t.body do %>
        <% failures.each do |failure| %>
          <% application = failure.application %>
          <%= t.row do %>
            <%= t.row_header application.salesforce_name %>
            <%= t.cell "#{application.first_name} #{application.last_name}".strip %>
            <%= t.cell do %>
              <span class="text-error font-semibold"><%= failure.label %></span>
              <% if failure.message.present? %>
                <div class="mt-1 whitespace-pre-wrap"><%= failure.message %></div>
              <% end %>
            <% end %>
            <%= t.cell application.salesforce_id %>
            <%= t.cell value_or_dash(failure.contact_id) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="mt-3">
      <%= export_csv_link(failures_csv_data_uri(failures), "Download CSV",
                          download: "salesforce-#{id}.csv") %>
    </div>
  <% end %>
<% end %>

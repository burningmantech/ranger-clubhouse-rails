<%# locals: (form:) -%>
<%= ui_form form, root_path,
            data: { turbo: false },
            html: { role: "form", "aria-label": "Sign in form" } do |f| %>

  <%= form_row do %>
    <%= f.email_field :email,
                      label: "Email Address",
                      required: true,
                      required_label: "",
                      autofocus: true,
                      autocomplete: "email",
                      placeholder: "you@example.com",
                      maxlength: 100,
                      icon: "envelope",
                      icon_type: :solid,
                      icon_class: "absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-warning",
                      replace_class: true,
                      class: "login-input",
                      wrapper_class: "login-field",
                      hide_label: false %>
  <% end %>

  <%# The label row is written here rather than by the builder: the way out of a
      forgotten password sits beside the field that asks for it, and a link
      inside a <label> would be a control inside a control. %>
  <div class="login-field">
    <div class="login-label-row">
      <%= f.label :password, "Password" %>
      <%= link_to "Forgot it?", forgot_path, class: "login-label-link",
                  "aria-label": "Forgot it? Reset your password" %>
    </div>
    <div class="relative" data-controller="password-reveal">
      <%= f.password_field :password,
                           hide_label: true,
                           required: true,
                           required_label: "",
                           autocomplete: "current-password",
                           placeholder: "Enter your password",
                           maxlength: 100,
                           icon: "key",
                           icon_type: :solid,
                           icon_class: "absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-warning",
                           replace_class: true,
                           class: "login-input login-input--reveal",
                           wrapper_class: "mb-0",
                           data: { password_reveal_target: "input" } %>
      <%# Masked by default; a press shows what was typed until the next press.
          Both glyphs are in the button and the controller shows one, on a span:
          the Font Awesome sheet's own display rule beats `hidden` on the <i>. %>
      <%= button_action safe_join([tag.span(fa_icon("eye", :solid), data: { password_reveal_target: "show" }),
                                   tag.span(fa_icon("eye-slash", :solid), class: "hidden",
                                            data: { password_reveal_target: "hide" })]), :ghost,
                        class: "login-reveal btn-square",
                        aria: { label: "Show password", pressed: "false" },
                        data: { action: "password-reveal#toggle", password_reveal_target: "button" } %>
    </div>
  </div>

  <div>
    <%= f.submit "Sign In",
                 variant: :warning,
                 size: "lg",
                 class: "login-submit-button",
                 data: { pending_label: "Signing in…" },
                 "aria-label": "Sign in to your account" %>
  </div>
<% end %>

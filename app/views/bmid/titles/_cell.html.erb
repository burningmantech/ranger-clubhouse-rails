<%# One badge line on the Set BMID Titles preview: the picker, and the text box
    the Custom option hands over to. conditional-show only reacts to a change,
    so the box's opening state has to be right from the server.

    A grid cell: the column heading is the visible label, so each field hides
    its own and carries an aria-label naming the person and the line. %>
<% custom_id = "bmid-custom-title-#{cell[:key]}" %>
<% label = "Title #{line} for #{person.callsign}" %>

<%= fields_for "titles", nil, builder: AppFormBuilder do |tf| %>
  <%= tf.select cell[:key],
                [["Blank", ""]] + cell[:options] + [["Custom title…", Bmid::TitlesController::CUSTOM]],
                { selected: cell[:selected], hide_label: true, width: "w-full", wrapper_class: "min-w-0",
                  aria: { label: label },
                  data: { controller: "conditional-show",
                          conditional_show_id_value: custom_id,
                          conditional_show_reveal_value: Bmid::TitlesController::CUSTOM } } %>
<% end %>

<div id="<%= custom_id %>" class="mt-1 <%= "hidden" if cell[:custom].blank? %>">
  <%= fields_for "custom_titles", nil, builder: AppFormBuilder do |cf| %>
    <%= cf.text_field cell[:key], value: cell[:custom], hide_label: true,
                      maxlength: BmidTitle::TITLE_LIMIT, width: "w-full", wrapper_class: "min-w-0",
                      aria: { label: "Custom #{label.downcase}" } %>
  <% end %>
</div>

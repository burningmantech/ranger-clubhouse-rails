<%# The category picker plus the text search, in the standard filter_bar
    shell. Both are ordinary GET params applied server-side, so a narrowed
    review is a shareable URL.

    Locals:
      q           - the active search text ("" when off)
      base_params - { year:, filter: }; ride on every link
      count       - result summary shown at the end of the bar %>
<%
  chips = bmid_export_filter_chips(q, base_params)
%>
<%= filter_bar id: "bmid-export-filters",
               chips: chips,
               clear_url: bmid_export_path(year: base_params[:year]),
               count: count,
               url: bmid_export_path do |f| %>
  <%# The year is chosen in the hero panel but has to survive an Apply. %>
  <%= hidden_field_tag :year, base_params[:year] %>

  <%= form_row do %>
    <%= f.select :filter, BmidManagement::FILTER_OPTIONS, label: "Category",
                 selected: base_params[:filter], width: "w-full", wrapper_class: "flex-1" %>
  <% end %>

  <%= form_row do %>
    <%= f.text_field :q, label: "Search", value: q,
                     help_text: "Matches any part of a callsign, title, team, or note.",
                     width: "w-full", wrapper_class: "flex-1" %>
  <% end %>

  <%= button_row do %>
    <%= f.submit "Apply Filters", variant: :secondary %>
  <% end %>
<% end %>

<%#
  The Bug Report dialog, opened from the top menu. It opens on a question --
  bug or feature request -- and the links re-render the modal frame with the
  answer: the report form, or where a feature request goes instead. A refused
  report comes back as the form, with the problem spelled out above the field.

  autofocus is here on purpose: a dialog puts focus on the first thing that
  can take it, and without this that is the close button in the title bar.
%>
<% if @bug_report %>
  <%= modal_dialog id: "bug-report-dialog", title: "Report a Bug" do %>
    <%= ui_form(@bug_report, bug_reports_path) do |f| %>
      <%= f.text_area :description, label: "What went wrong?", rows: 6,
                      required: true, autofocus: true, maxlength: BugReport::DESCRIPTION_LIMIT,
                      help_text: "Say what you were doing and what happened instead. The page you are on, your browser, and your IP address are sent with the report." %>
      <%= modal_form_footer f, submit: "Send Bug Report" %>
    <% end %>
  <% end %>
<% elsif @kind == "feature" %>
  <%= modal_dialog id: "bug-report-dialog", title: "Feature Request" do %>
    <p class="mb-2">
      <strong>This dialog is for bugs only.</strong> To ask for a new feature, contact the cadre
      that manages that part of the Clubhouse. The
      <%= link_to "Cadre Directory", me_directory_path, data: { turbo_frame: "_top" } %> lists them.
    </p>
    <p>
      Not sure who that is? Email the Tech Cadre at
      <%= mail_to EmailAddresses::TECH_CADRE %> for guidance.
    </p>
    <%= button_row do %>
      <%= modal_close_button "Close" %>
    <% end %>
  <% end %>
<% else %>
  <%= modal_dialog id: "bug-report-dialog", title: "Bug Report" do %>
    <p>Did something break, or would you like the Clubhouse to do something new?</p>
    <%= button_row do %>
      <%= button_link "Report a Bug", :primary, new_bug_report_path(kind: "bug"), autofocus: true %>
      <%= button_link "Request a Feature", :secondary, new_bug_report_path(kind: "feature") %>
      <%= modal_close_button "Cancel" %>
    <% end %>
  <% end %>
<% end %>

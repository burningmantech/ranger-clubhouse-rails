<%= hero_panel icon: "coins", heading_level: :h1, id: "scheduling-position-credit-form-header",
               description: "Pick one position, or several to create the same credit for each of them.",
               back_to: ["#{@year} Position Credits", @cancel_path] do |panel| %>
  <% panel.title do %>Create Position Credit for <%= @year %><% end %>
<% end %>

<% unless @is_current_year %>
  <div class="my-2">
    <%= ui_callout_box :warning, title: "Not the Current Year" do %>
      You are creating a position credit while viewing a prior year (<%= @year %>).
      Double-check the beginning time is for the year you intend.
    <% end %>
  </div>
<% end %>

<%= render "form" %>

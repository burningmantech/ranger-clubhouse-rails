<%= hero_panel icon: "calendar-plus", heading_level: :h1, id: "scheduling-slot-form-header",
               description: @slot.description.present? ? "Change the #{@slot.position_title} slot “#{@slot.description}”." : "Change this #{@slot.position_title} slot.",
               back_to: ["#{@slot.position_title} Slots", @cancel_path] do |panel| %>
  <% panel.title do %>Edit Slot #<%= @slot.id %><% end %>
<% end %>

<%= render "form" %>

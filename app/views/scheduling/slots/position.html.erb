<%= hero_panel icon: "calendar-days", heading_level: :h1, id: "scheduling-position-slots-header",
               description: "Edit, repeat, or delete this position's slots, or apply bulk changes.",
               back_to: ["#{@year} Slots", scheduling_slots_path(year: @year)] do |panel| %>
  <% panel.title do %><%= @year %> <%= @position.title %> Slots
  <% end %>
<% end %>

<%= ui_stat_row do %>
  <%= ui_stat_box @total_count, "Slots" %>
  <% if @inactive_count.positive? %>
    <%= ui_stat_box @inactive_count, "Inactive", variant: :warning %>
  <% end %>
<% end %>

<div class="my-4">
  <%= button_row do %>
    <%= button_link "Add Slot", :primary,
                    scheduling_new_slot_path(position_id: @position.id, year: @year),
                    icon: "plus", icon_type: :solid %>
    <% if @total_count.positive? %>
      <%= button_link "Activate All", :secondary,
                      scheduling_slots_position_active_path(@position.id, active: 1, year: @year),
                      method: :post, icon: "circle-check" %>
      <%= button_link "Deactivate All", :secondary,
                      scheduling_slots_position_active_path(@position.id, active: 0, year: @year),
                      method: :post, icon: "circle-pause" %>
      <%= button_link "Bulk Copy", :secondary,
                      scheduling_new_slot_copy_path(position_id: @position.id, year: @year),
                      icon: "copy" %>
      <%= button_link "Bulk Edit", :secondary,
                      scheduling_new_slot_bulk_edit_path(@position.id, year: @year),
                      icon: "pen-to-square" %>
    <% end %>
  <% end %>
</div>

<% if @total_count.positive? %>
  <%= filter_bar id: "slot-filters",
                 chips: slot_filter_chips(@position, @year),
                 clear_url: scheduling_slots_position_path(@position.id, year: @year),
                 count: "Showing #{@slots.size} of #{@total_count} slots",
                 url: scheduling_slots_position_path(@position.id) do |f| %>
    <%= hidden_field_tag :year, @year %>
    <%= form_row do %>
      <%= f.select :day,
                   options_for_select([["All days", ""]] + @day_options.map { |day| [wday_month_day_format(day), day.iso8601] },
                                      params[:day]),
                   { label: "Day", width: "w-full sm:w-44" } %>
      <%= f.select :active,
                   options_for_select([["All slots", ""], ["Active", "active"], ["Inactive", "inactive"]],
                                      params[:active]),
                   { label: "Status", width: "w-full sm:w-44" } %>
      <%= f.select :description,
                   options_for_select([["All descriptions", ""]] + @description_options,
                                      params[:description]),
                   { label: "Description", width: "w-full sm:w-64" } %>
    <% end %>
    <%= button_row do %>
      <%= f.submit "Apply Filters", variant: :secondary %>
    <% end %>
  <% end %>
<% end %>

<% if @slots.any? %>
  <%= ui_form(nil, scheduling_slots_position_bulk_delete_path(@position.id, year: @year),
              method: :delete, local: true, no_error_summary: true) do |f| %>
    <%= bulk_select do %>
      <%= ui_table do |t| %>
        <%= t.header do %>
          <%= t.heading width: "1%" do %>
            <%= bulk_select_all aria_label: "Select all slots" %>
          <% end %>
          <%= t.heading "Slot" %>
          <%= t.heading "Sign-Ups", right: true %>
          <%= t.heading "Duration", right: true %>
          <%= t.heading "Credits", right: true %>
          <%= t.heading "Attributes" %>
          <%= t.heading "Actions", right: true %>
        <% end %>
        <%= t.body do %>
          <% @slots.each do |slot| %>
            <%= t.row id: "slot-#{slot.id}" do %>
              <%= t.cell do %>
                <%= bulk_select_checkbox "slot_ids[]", slot.id, id: "select-slot-#{slot.id}",
                                         aria_label: "Select slot ##{slot.id} #{slot.description}" %>
              <% end %>
              <%# Laid out as Position Records lays out a position: the status icon,
                  the time as the record's name, and what the slot is beneath it. %>
              <%= t.row_header do %>
                <%= record_title datetime_format(slot.begins, slot.ends, tz: slot.timezone, tz_abbr: slot.timezone_abbr),
                                 active: slot.active do %>
                  <div class="text-stone-muted"><%= [slot.description.presence, "##{slot.id}"].compact.join(" · ") %></div>
                  <% unless slot.active %>
                    <div class="mt-1">
                      <%= ui_badge "Inactive", :warning, size: "sm", class: "whitespace-nowrap" %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
              <%= t.cell "#{slot.signed_up} of #{slot.max}", right: true, class: "whitespace-nowrap" %>
              <%= t.cell right: true do %>
                <%= hour_minute_format slot.duration %>
              <% end %>
              <%= t.cell credit_format_short(slot.credits), right: true %>
              <%= t.cell do %>
                <%= value_list(slot_attributes(slot)) %>
                <%= render "common/scheduling/slot_additional_info", slot: slot, collapsed: true %>
              <% end %>
              <%= t.cell right: true do %>
                <%# The repeat icons ride in the label slot so ButtonHelper's icon: margin is not added. %>
                <div class="flex-center-gap-2 justify-end">
                  <%= button_link fa_icon("clone"), :secondary,
                                  scheduling_repeat_slot_path(slot, year: @year),
                                  method: :post, title: "Repeat", aria: { label: "Repeat" },
                                  class: "btn-square" %>
                  <%= button_link fa_icon("clone") + tag.span("+24h"), :secondary,
                                  scheduling_repeat_slot_path(slot, add24: 1, year: @year),
                                  method: :post, title: "Repeat +24h", aria: { label: "Repeat +24h" } %>
                  <%= edit_link scheduling_edit_slot_path(slot, year: @year), "Edit Slot" %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
      <%= button_row do %>
        <%= f.submit "Delete Selected Slots", variant: :error,
                     data: {
                       turbo_confirm: confirm_modal_dialog(
                         title: "Confirm Slot Deletion",
                         message: "Delete the selected slots? " \
                           "Anyone signed up will be removed from those shifts. This cannot be undone.",
                         confirm_label: "Delete Slots",
                         variant: :error
                       ),
                       checkbox_select_all_target: "submit"
                     } %>
        <%= bulk_select_count class: "text-stone-subtle" %>
      <% end %>
    <% end %>
  <% end %>
<% elsif @total_count.positive? %>
  <%= ui_empty_state "No slots match the current filters.", icon: "filter", icon_type: :solid %>
<% else %>
  <%= ui_empty_state "No #{@position.title} slots were found for #{@year}.",
                     icon: "calendar-plus", icon_type: :solid %>
<% end %>

<%# locals: (label: "Alpha Shift", url: nil, hint: "Use your browser's print command.") %>
<%# Screen-only return link + print hint shared by every Mentoring print sheet.
    The three Alpha shift sheets take the defaults; the pods, acceptance and
    mentor-assignment sheets name their own way back. %>
<div class="print:hidden mb-4">
  <%= back_to label, url || mentoring_alpha_schedule_shift_path(@slot) %>
  <p class="text-stone-muted mt-1">
    <%= hint %> This message and the navigation are left off the paper.
  </p>
</div>

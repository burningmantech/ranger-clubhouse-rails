<%#
  Change one person's place in the pods: mark a mentor as the lead, move them
  to another pod, step them up or down the order, or take them out.

  Removal asks first, and says it can be undone: the row is kept with
  removed_at stamped, so adding them back restores it. Deleting a whole pod
  asks too, and says it cannot.
%>
<% pod_name = alpha_pod_name(@pod) %>
<% options = @member_pods.map { |pod| [alpha_pod_name(pod), pod.id] } %>
<%= modal_dialog id: "alpha-pod-member-dialog", title: "#{@person.callsign} in #{pod_name}" do %>
  <%= form_with url: mentoring_alpha_pods_person_path(@slot, @pod, @person), method: :patch,
                builder: AppFormBuilder, data: { turbo_frame: "_top" } do |f| %>
    <% if @pod.mentor? %>
      <%= f.check_box :is_lead, label: "Lead mentor for this pod", checked: @member&.is_lead %>
    <% end %>

    <% if options.size > 1 %>
      <%= f.select :new_pod_id, options_for_select(options, @pod.id),
                   { label: "Pod", width: "w-full sm:w-44",
                     help_text: "Moving someone keeps a record that they were in #{pod_name} first." },
                   { id: "alpha-pod-new-pod" } %>
    <% end %>

    <%= modal_form_footer submit: "Save Changes" %>
  <% end %>

  <div class="mt-4 pt-3 border-t border-line">
    <p class="text-stone-muted mb-2">
      <%= @pod.alpha? ? "Alphas walk in the order shown on the card." : "Order decides how the pod is listed." %>
    </p>
    <%= button_row do %>
      <%= button_link "Move Up", :secondary,
                      mentoring_alpha_pods_person_path(@slot, @pod, @person, direction: Pod::MOVE_UP),
                      method: :patch, size: "sm", icon: "arrow-up", icon_type: :solid,
                      data: { turbo_frame: "_top" } %>
      <%= button_link "Move Down", :secondary,
                      mentoring_alpha_pods_person_path(@slot, @pod, @person, direction: Pod::MOVE_DOWN),
                      method: :patch, size: "sm", icon: "arrow-down", icon_type: :solid,
                      data: { turbo_frame: "_top" } %>
      <%= delete_button mentoring_alpha_pods_person_path(@slot, @pod, @person),
                        "Remove from #{pod_name}", size: "sm",
                        confirm_message: "Remove #{@person.callsign} from #{pod_name}? " \
                                         "Adding them back undoes it.",
                        data: { turbo_frame: "_top" } %>
    <% end %>
  </div>
<% end %>

<%= hero_panel icon: "link", heading_level: :h1, id: "external-ids-header",
               back_to: [@person.callsign, person_path(@person)] do |panel| %>
  <% panel.title do %>
    External IDs &mdash; <%= @person.callsign %>
  <% end %>
  <% panel.description do %>
    Identifiers used to associate this Clubhouse account with external websites such as
    Burner Profiles and the Moodle Learning Management System.
  <% end %>
<% end %>

<%= ui_section "External Account Identifiers", icon: "link", icon_type: :solid do %>
  <%= ui_form(@person, person_external_ids_path(@person), method: :patch) do |f| %>
    <%= f.text_field :bpguid,
                     label: "Burner Profile Global UID (BPGUID)",
                     maxlength: 64,
                     width: "w-full sm:w-96" %>

    <%= f.text_field :lms_id,
                     label: "Moodle Account ID (aka idnumber)",
                     maxlength: 191,
                     width: "w-full sm:w-72" %>

    <%= f.text_field :lms_username,
                     label: "Moodle Username",
                     maxlength: 191,
                     width: "w-full sm:w-72",
                     help_text: "Aka callsign, lower case, only alphanumeric characters, no spaces." %>

    <%= f.text_field :employee_id,
                     label: "Paycom Employee ID",
                     maxlength: 10,
                     width: "w-32",
                     help_text: "Use 0 to allow paid shifts without compensation." %>

    <%= button_row do %>
      <%= f.submit "Save External IDs" %>
      <%= cancel_link person_path(@person) %>
    <% end %>
  <% end %>
<% end %>

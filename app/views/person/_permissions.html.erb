<%# locals: (rows:, nda_blocked:) %>
<% active, inactive = rows.partition(&:active) %>
<%= ui_section "Permissions", icon: "shield-halved", icon_type: :solid,
    badge: (rows.empty? ? "0" : "#{active.size} of #{rows.size} active"),
    edit_link: (can_edit_permissions? ? person_permissions_path(@person) : nil) do %>
  <% if rows.empty? %>
    <%= ui_empty_state "No permissions granted.", icon: "shield-halved", icon_type: :solid %>
  <% else %>
    <% if nda_blocked %>
      <%= ui_callout_box :warning do %>
        All permissions are off because <%= @person.callsign %> has not signed the Sensitive Data Access and Use Policy.
        <%# The same roles Person::AgreementsController admits, so the link never bounces. %>
        <% if has_role?([Role::ADMIN, Role::EVENT_MANAGEMENT]) %>
          <%= link_to "View Agreements", person_agreements_path(@person), class: "tap-target-link" %>
        <% end %>
      <% end %>
    <% end %>
    <%# Two lists, as Teams & Positions above: a list with no rows is left out.
        The unsigned policy turns every permission off, and the callout says so. %>
    <% [["Active", active, active.size <= 4], ["Inactive", inactive, !nda_blocked]].each do |label, list, open| %>
      <% next if list.empty? %>
      <% reasons = list.equal?(inactive) %>
      <%= ui_accordion("#{label} (#{pluralize(list.size, "permission")})", open:) do %>
        <%# Not striped: a long Granted Through list opens in a detail row, and a
            hidden row still counts toward the stripes (components/tables.css). %>
        <%= ui_table full_width: true, striped: false do |t| %>
          <%= t.header do %>
            <%# lg:w-px: the column is only as wide as its names, so what follows starts
                beside them and not half a table away. lg:pe-8 is the gap that leaves. %>
            <%= t.heading "Permission", class: "lg:w-px lg:pe-8" %>
            <%= t.heading "Why It Is Inactive" if reasons %>
            <%= t.heading "Granted Through" %>
          <% end %>
          <%= t.body do %>
            <% list.each_with_index do |row, index| %>
              <% folded = permission_paths_folded?(row) %>
              <% paths_id = "permission-paths-#{label.downcase}-#{index}" %>
              <%= t.row do %>
                <%= t.row_header row.title, class: "lg:pe-8" %>
                <%= t.cell permission_inactive_reasons(row, nda_blocked:) if reasons %>
                <%= t.cell do %>
                  <% if folded %>
                    <%# lg:-ms-3 takes back the button's own inset in the table, so its
                        label starts where the lists in the rows around it do. %>
                    <%= t.detail_row_toggle permission_paths_summary(row), id: paths_id,
                                            describing: row.title, class: "lg:-ms-3" %>
                  <% else %>
                    <%= permission_paths(row) %>
                  <% end %>
                <% end %>
              <% end %>
              <% if folded %>
                <%= t.detail_row id: paths_id, label: row.title do %>
                  <%= permission_paths(row, columns: true) %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

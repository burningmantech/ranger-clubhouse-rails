<%# locals: (list:, title:, name:, is_position: false, is_signups: false, no_advisory: false) %>
<div class="mt-2">
  <% if list.present? %>
    <strong><%= pluralize(list.length, title) %></strong>
    <p>
      <% if is_position %>
        <% unless no_advisory %>
          Note: if this person is not a member of a <%= name %>-eligible team, at least one shift of the
          following position(s) must be signed up for first before they may become <%= name %> eligible.
        <% end %>
      <% elsif is_signups %>
        This person is MVR eligible because the following shift(s) were signed up:
      <% else %>
        This person is automatically <%= name %> eligible because they are a member of the following team(s):
      <% end %>
    </p>

    <% if is_signups %>
      <%= ui_table full_width: false, striped: false, responsive: false do |t| %>
        <%= t.header do %>
          <%= t.heading "Position" %>
          <%= t.heading "Start Time" %>
        <% end %>
        <%= t.body do %>
          <% list.each do |signup| %>
            <%= t.row do %>
              <%= t.cell signup.position_title %>
              <%= t.cell datetime_format(signup.begins, tz: signup.timezone) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
        <% list.each do |item| %>
          <div><%= item.title %></div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    No <%= title %>s
  <% end %>
</div>

<%= hero_panel icon: "plus", heading_level: :h1, id: "new-person-certification-header",
               description: "Record a certification or external training for this person.",
               back_to: ["Certifications", person_certifications_path(@person)] do |panel| %>
  <% panel.title do %>
    New Certification &mdash; <%= @person.callsign %>
  <% end %>
<% end %>

<%= render "form", person: @person, person_certification: @person_certification, certifications: @certifications %>

<%# locals: (person:, note:, label:, can_write: false, origin_params: {}) %>
<%#
  One intake note, shared by the person page and the VC pipeline page's detail
  frame. origin_params carries the "came from the VC page" context so edit and
  delete return to whichever page opened them.
%>
<li>
  <div class="text-sm text-stone-muted mb-1">
    <%= datetime_format(note.created_at, tz: "America/Los_Angeles", tz_abbr: "PT", year: true) %>
    by
    <% if note.person_source %>
      <%= note.person_source.callsign %>
    <% else %>
      <i>*imported*</i>
    <% end %>
  </div>
  <div class="text-body"><%= simple_format(note.note) %></div>
  <% if can_write %>
    <div class="mt-1 flex flex-wrap gap-2">
      <%= edit_link edit_person_intake_note_path(person, note, origin_params), "Edit",
                    aria: { label: "Edit #{label} note from #{mdy_format(note.created_at)}" } %>
      <%= delete_button person_intake_note_path(person, note, origin_params), "Delete",
                        confirm_modal: {
                          title: "Delete Note",
                          message: "Delete this #{label} note? This cannot be undone.",
                          confirm_label: "Delete Note",
                          method: :delete
                        } %>
    </div>
  <% end %>
</li>

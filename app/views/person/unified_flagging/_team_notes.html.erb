<%# locals: (person:, team_key:, label:, icon:, entries:, can_write:, show_add_button: true) %>
<% show_add_button = local_assigns.fetch(:show_add_button, true) %>
<%= ui_section label, icon: icon, icon_type: :solid, badge: entries.size.to_s do %>
  <% if entries.blank? %>
    <% if can_write %>
      <p class="text-body mb-3">No <%= label %> notes yet.</p>
    <% else %>
      <%= ui_empty_state "No #{label} notes.", icon: icon, icon_type: :solid %>
    <% end %>
  <% else %>
    <% entries.reverse_each do |entry| %>
      <div class="mb-4 pb-4 border-b border-line last:border-0 last:pb-0 last:mb-0">
        <div class="flex items-center gap-2 mb-2">
          <span class="font-semibold text-heading text-lg"><%= entry[:year] %></span>
          <%= intake_rank_badge(entry[:rank]) %>
        </div>

        <% non_log_notes = entry[:notes].reject(&:is_log) %>
        <% if non_log_notes.any? %>
          <ul class="space-y-3">
            <%= render partial: "person/unified_flagging/note", collection: non_log_notes, as: :note,
                       locals: { person: person, label: label, can_write: can_write, origin_params: {} } %>
          </ul>
        <% else %>
          <p class="text-body">No notes.</p>
        <% end %>

        <% log_notes = entry[:notes].select(&:is_log) %>
        <% if log_notes.any? %>
          <%= ui_disclosure "Rank Change History (#{log_notes.size})",
                            class: "mt-3", summary_class: "text-stone-muted" do %>
            <ul class="mt-2 space-y-1 text-stone-muted">
              <% log_notes.each do |note| %>
                <li>
                  <i>
                    <%= datetime_format(note.created_at, tz: "America/Los_Angeles", tz_abbr: "PT", year: true) %>
                    by
                    <% if note.person_source %>
                      <%= note.person_source.callsign %>
                    <% else %>
                      *imported*
                    <% end %>
                    &mdash; <%= note.note %>
                  </i>
                </li>
              <% end %>
            </ul>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if can_write && show_add_button %>
    <div class="mt-3">
      <%= button_link "Add Note / Rank", :primary, new_person_intake_note_path(person, type: team_key),
                      icon: "plus", icon_type: :solid %>
    </div>
  <% end %>
<% end %>

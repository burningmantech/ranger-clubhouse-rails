<% if positions.present? %>
  <%= tag.div data: { position_category: local_assigns[:category] } do %>
    <div class="text-stone-muted mb-1"><%= title %></div>
    <div class="ml-3">
      <% positions.each do |position| %>
        <%= render "position_checkbox", item: position, param_key: param_key %>
      <% end %>
    </div>
  <% end %>
<% end %>

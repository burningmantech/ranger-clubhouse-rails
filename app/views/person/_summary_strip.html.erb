<%# locals: (person:, person_fkas:, photo:) %>
<%= ui_section "Overview", id: "person-summary-strip" do %>
  <%# The facts, and with them the rail of what this viewer may do
      (person/_actions): beside the facts from `lg`, under them below it. No
      list has a heading: every field is named by its own label. Inside the
      facts every wrap is by the content's width, never at the page fold: the
      photo stays beside the lists while both fit, and the lists sit as many
      across as the row holds. %>
  <div class="flex flex-col gap-4 lg:flex-row">
    <div class="flex min-w-0 grow flex-wrap items-start justify-center gap-4">
      <%= render partial: "person/photo", locals: { photo: photo, person: person } %>

      <div class="flex min-w-0 grow basis-80 flex-col gap-3">
        <div class="grid gap-4">
          <% if can_view_email? || can_view_pii? %>
            <%= render layout: "person/summary_group" do %>
              <%= ui_label_value layout: :fitted do |list| %>
                <% if can_view_email? %>
                  <% list.row "Email" do %>
                    <%= clipboard_button person.email, label: "Copy email address" do %>
                      <%= mail_to person.email, nil, class: "tap-target-link" %>
                    <% end %>
                  <% end %>
                <% end %>

                <% if can_view_pii? %>
                  <% list.row "Phone" do %>
                    <% if person.home_phone.present? %>
                      <%= clipboard_button person.home_phone, label: "Copy phone number" do %>
                        <%= link_to phone_format(person.home_phone), "tel:#{person.home_phone}", class: "tap-target-link" %>
                      <% end %>
                    <% else %>
                      <%= none_stated %>
                    <% end %>
                  <% end %>

                  <% if person.alt_phone.present? %>
                    <% list.row "Alt. Phone" do %>
                      <%= clipboard_button person.alt_phone, label: "Copy alternate phone number" do %>
                        <%= link_to phone_format(person.alt_phone), "tel:#{person.alt_phone}", class: "tap-target-link" %>
                      <% end %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <% if !person.is_auditor? && !person.is_applicant? %>
            <%= render layout: "person/summary_group" do %>
              <%= ui_label_value layout: :fitted do |list| %>
                <% unless person.is_echelon? %>
                  <% list.row "Rangered" do %>
                    <% if person.years_as_ranger.present? %>
                      <%= pluralize(person.years_as_ranger.length, "event") %>
                      <%= muted_aside "[#{year_range person.years_as_ranger}]" %>
                    <% else %>
                      —
                    <% end %>
                  <% end %>
                <% end %>

                <% if person.years_as_contributor.present? || person.is_echelon? %>
                  <% list.row "Echelon Years" do %>
                    <% if person.years_as_contributor.present? %>
                      <%= pluralize(person.years_as_contributor.length, "event") %>
                      <%= muted_aside "[#{year_range person.years_as_contributor}]" %>
                    <% else %>
                      —
                    <% end %>
                  <% end %>
                <% end %>

                <% list.row "Service Years" do %>
                  <% if person.years_of_service.present? %>
                    <%= pluralize(person.years_of_service.length, "year") %>
                    <%= muted_aside "[#{year_range person.years_of_service}]" %>
                  <% else %>
                    —
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>

          <%= render layout: "person/summary_group" do %>
            <%= ui_label_value layout: :fitted do |list| %>
              <%# Whether the callsign is approved. With no heading over the
                  list, "Approval" alone would not say of what. %>
              <% list.row "Callsign" do %>
                <% if person.callsign_approved %>
                  <%= ui_badge "approved", :success %>
                <% else %>
                  <%= ui_badge "not approved", :error %>
                <% end %>
              <% end %>

              <% list.row "Former Callsigns" do %>
                <% if person_fkas.any? %>
                  <%= safe_join(person_fkas.map { |fka| tag.span(fka, class: "inline-block") }, ", ") %>
                <% else %>
                  —
                <% end %>
              <% end %>

              <% if person.used_vanity_change %>
                <% list.row "Vanity Change" do %>
                  One-time vanity change used
                  <% if person.vanity_changed_at.present? %>
                    on <%= datetime_format person.vanity_changed_at, year: true %>
                  <% else %>
                    <span class="text-stone-muted">(date unknown)</span>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <%= ui_label_value layout: :fitted, class: "border-t border-base-300 pt-3" do |list| %>
          <% list.row "Last Seen" do %>
            <%= render "person/timestamp_value", at: person.last_seen_at, none: "Never" %>
          <% end %>

          <%# The first-sign-in tour (me/dashboard/_onboarding); the rail's
              Reset Onboarding Tour clears it. %>
          <% list.row "Onboarding Tour" do %>
            <%= render "person/timestamp_value", at: person.on_boarded_at, none: "Not yet taken" %>
          <% end %>

          <% list.row "Created" do %>
            <%= render "person/timestamp_value", at: person.created_at, none: "Before 2010" %>
          <% end %>

          <%# The public page a Regional Event checks this person on (Voucher).
              PersonController#show gives the person a uuid when the row has none. %>
          <% list.row "Voucher Link" do %>
            <%= clipboard_button voucher_url(person.uuid), label: "Copy voucher link" do %>
              <%= link_to "Open voucher page", voucher_path(person.uuid), class: "tap-target-link",
                          target: "_blank", rel: "noopener" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render "person/actions", person: person %>
  </div>
<% end %>

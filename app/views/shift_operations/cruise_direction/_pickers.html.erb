<%# locals: (shifts:, slot:, year:) %>
<%#
  The shift picker: a GET form back to this page that reloads it with the
  chosen shift in the query string. Deliberate -- the board it produces is the
  whole page, so it should be a real URL that survives a reload and a back
  button, unlike the writes below it, which are streams.

  The year rides along in a hidden field. Without it, changing shift would drop
  the year and land the reader on the current one, which is a different list of
  shifts than the one they just chose from.

  The shift's actions sit directly under the select: the shift is what they act
  on, so the three read as one control block. Both actions need a chosen shift,
  so they render, like the status badge, only once there is one.
%>
<%# Spacing belongs to the row this sits in, alongside the shift's counts. %>
<div class="flex flex-col w-full lg:w-auto lg:min-w-64">
  <%= form_with url: shift_operations_cruise_direction_path, method: :get, builder: AppFormBuilder,
                data: { controller: "form" } do |f| %>
    <%= f.select :slot_id,
                 grouped_options_for_select(cruise_direction_shift_option_groups(shifts), slot&.id),
                 { label: "Shift", include_blank: "Select a shift", width: "w-full", wrapper_class: "" },
                 { data: { action: "change->form#submit" } } %>

    <%= hidden_field_tag :year, year, id: nil %>

    <%# The picker auto-submits, so this only ever fires without JavaScript. %>
    <noscript><%= submit_button "Show Pods" %></noscript>
  <% end %>

  <% if slot && (status = cruise_direction_shift_status(slot)) %>
    <% variant, label, icon = status %>
    <div class="mt-2"><%= ui_badge label, variant, icon: icon, icon_type: :solid %></div>
  <% end %>

  <% if slot %>
    <%= button_row class: "mt-2" do %>
      <%# The dialog opens into the layout's modal frame; its submit escapes to
          _top, because the answer is a stream that replaces the board. %>
      <%= button_link "Add Pod", :primary,
                      shift_operations_new_cruise_direction_pod_path(slot_id: slot.id, year: year),
                      icon: "plus", icon_type: :solid, data: { turbo_frame: "modal" } %>
      <%# A plain link, not a stream: the operator wants the whole page as it
          stands now, and this page is left open for hours. %>
      <%= button_link "Refresh", :secondary, cruise_direction_refresh_path(slot, shifts, year),
                      icon: "arrows-rotate", icon_type: :solid %>
    <% end %>
  <% end %>
</div>

<%# locals: (shift: true) %>
<%#
  The roster pickers, shared by both modes. Sign In chooses a position and then
  a shift under it; Sign Out passes shift: false, because there is no shift to
  choose -- only the position whose crew is coming off.

  A GET form back to this page: choosing a select reloads it with the choice
  in the query string. That is deliberate -- the roster it produces is the whole
  page, so it should be a real URL that survives a reload and a back button,
  unlike the taps on the rows below it.

  Changing position carries the old slot_id along, which then matches nothing in
  the new position and lands on "pick a shift" -- the same reset upstream does
  client-side, without a second round of wiring to do it.
%>
<%= form_with url: request.path, method: :get, builder: AppFormBuilder,
              data: { controller: "form" },
              class: "flex flex-col lg:flex-row lg:items-end gap-3" do |f| %>
  <%= f.select :position_id,
               grouped_options_for_select(rollcall_position_option_groups(@groups), @group&.id),
               { label: "Position", include_blank: "Select a position", width: "w-full lg:w-auto",
                 wrapper_class: "" },
               { data: { action: "change->form#submit" } } %>

  <% if shift %>
    <%= f.select :slot_id,
                 options_for_select(rollcall_slot_options(@group), @slot&.id),
                 { label: "Shift", include_blank: "Select a shift", width: "w-full lg:w-auto",
                   wrapper_class: "" },
                 { disabled: @group.nil?, data: { action: "change->form#submit" } } %>

    <%# Carried, not dropped: an operator who set a check-in time is mid-task,
        and changing shift is part of that task. %>
    <%= hidden_field_tag :start_time, @start_time, id: nil if @start_time %>
  <% end %>

  <%# The pickers auto-submit, so this only ever fires without JavaScript. %>
  <noscript><%= submit_button "Show Roster" %></noscript>
<% end %>

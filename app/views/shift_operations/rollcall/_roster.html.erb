<%# locals: (rows:, counts:, mode:, position_id:, slot_id: nil, start_time: nil) %>
<%#
  The roster itself: a sticky bar carrying the count and the callsign filter,
  then the rows.

  One column on a phone, two on a tablet, three on a desktop. The rows are
  full-width targets at every width -- narrowing them into a card grid would
  trade the one property that makes this page usable with gloves on.

  The filter is client-side and nothing more: it hides rows whose callsign
  does not match. Rows arrive and leave by turbo stream, so it re-applies
  itself whenever the list changes rather than filtering once on load.
%>
<div data-controller="list-filter" data-list-filter-key-value="callsign">
  <div class="sticky top-0 z-10 bg-base-100 border-b border-line py-2 mb-3
              flex flex-col lg:flex-row lg:items-center gap-2">
    <%= render "shift_operations/rollcall/count", counts: counts, mode: mode %>
    <div class="lg:ms-auto lg:w-72">
      <label for="rollcall-filter-input" class="sr-only">Filter by callsign</label>
      <input type="search" id="rollcall-filter-input" class="input w-full"
             placeholder="Filter by callsign…" autocomplete="off"
             data-list-filter-target="input"
             data-action="input->list-filter#apply search->list-filter#apply">
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-2">
    <% rows.each do |row| %>
      <%= render "shift_operations/rollcall/row",
                 row: row, mode: mode, position_id: position_id,
                 slot_id: slot_id, start_time: start_time %>
    <% end %>
  </div>

  <%# Shown by the filter controller when nothing matches, so a mistyped
      callsign reads as "no match" rather than as an empty roster. %>
  <%= ui_empty_state "No callsign on this roster matches that.",
                     icon: "filter", icon_type: :solid, hidden: true,
                     data: { list_filter_target: "empty" } %>
</div>

<%# locals: (icon:, title:, photo: nil, lines: []) %>
<%#
  One row of an autocomplete dropdown, whatever it is a row of: a 32px avatar
  or a placeholder circle, a bold title, and any number of muted meta lines.

  The three callers differ only in what they put in those slots, so the layout
  lives here and each caller keeps the logic that builds its own strings.

  lines entries are plain strings; ERB escapes them, so a value containing < or
  & is safe to pass through.
%>
<div class="flex items-center gap-3 px-3 py-2">
  <div class="shrink-0 w-8 h-8">
    <% if photo %>
      <%= image_tag photo, width: 32, height: 32, class: "rounded-full object-cover w-8 h-8", alt: "" %>
    <% else %>
      <div class="w-8 h-8 rounded-full bg-neutral flex items-center justify-center text-neutral-content">
        <%= fa_icon icon, :solid, class: "text-xs" %>
      </div>
    <% end %>
  </div>
  <div class="flex-1 min-w-0">
    <div class="font-medium text-heading text-sm truncate"><%= title %></div>
    <% lines.each do |line| %>
      <div class="text-xs text-stone-muted truncate"><%= line %></div>
    <% end %>
  </div>
</div>

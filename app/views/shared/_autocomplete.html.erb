<%# locals: (url:, mode: nil, name: nil, input_id: nil, field_id: nil, describedby: nil, invalid: false, wrapper_class: nil, form_field: false, placeholder: "Search...", min_length: 2, limit: 5, delay: 300, meta_mapping: nil, submit_on_select: false, recents_key: nil, autofocus: false, input_class: nil, results_class: nil, hidden_field_name: nil, hidden_field_id: nil, aria_label: "Search", input_data: nil, inline: false, select_on_blur: false, keyboard_help: false, type: "text", value: nil, maxlength: nil, free_text: false, positioned: true) %>
<%# field_id: the text input's own id, for a form label that names it; describedby: its help or error line;
    wrapper_class: the component's own box, as a flex item in a field (callsign_chips_field);
    form_field: a field with no hidden target, whose selection only dispatches autocomplete.change;
    aria_label: nil when a <label for=field_id> names the input, since an aria-label would outrank it.
    free_text: the text is itself a choice (the mailbox search, MessagesConcern#suggest): the first row stands for it
    and arrives highlighted, and Enter sends the form with the text unless the reader picked another row.
    positioned: false hangs the list from the box the caller positions around the component, across all of it: a
    chips field's, where the component is only the text after the chips (shared/_callsign_chips,
    common/messages/_search_field). %>
<%
  wrapper_id = input_id || "autocomplete-#{SecureRandom.hex(4)}"
  results_id = "#{wrapper_id}-results"
  input_field_id = field_id || "#{wrapper_id}-input"
%>
<%# A nil leaves its attribute out, but inside data: and aria: a false prints "false": hence (true if …) and .presence. %>
<%= tag.div id: wrapper_id, role: "combobox", class: class_names(wrapper_class, relative: positioned),
            aria: { expanded: "false", haspopup: "listbox", owns: results_id, label: aria_label.presence },
            data: { controller: "autocomplete",
                    autocomplete_url_value: url,
                    autocomplete_response_type_value: "json",
                    autocomplete_min_length_value: min_length,
                    autocomplete_delay_value: delay,
                    autocomplete_limit_value: limit,
                    autocomplete_mode_value: mode.presence,
                    autocomplete_meta_mapping_value: (meta_mapping.to_json if meta_mapping.present?),
                    autocomplete_submit_on_select_value: (true if submit_on_select),
                    autocomplete_form_field_value: (true if form_field),
                    autocomplete_inline_value: (true if inline),
                    autocomplete_select_on_blur_value: (true if select_on_blur),
                    autocomplete_free_text_value: (true if free_text),
                    autocomplete_recents_key_value: recents_key.presence } do %>

  <%= tag.input type:, id: input_field_id, name: name.presence, value:, maxlength:, autofocus:, placeholder:,
                autocomplete: "off", spellcheck: "false", autocorrect: "off", autocapitalize: "off",
                class: input_class || "#{AppFormBuilder::INPUT_CLASSES} w-full",
                aria: { autocomplete: "list", controls: results_id, label: aria_label.presence,
                        describedby: describedby.presence, invalid: (true if invalid) },
                data: { autocomplete_target: "input", **input_data.to_h } %>

  <% if hidden_field_name.present? %>
    <%= tag.input type: "hidden", name: hidden_field_name, id: hidden_field_id.presence,
                  data: { autocomplete_target: "hidden" } %>
  <% end %>

  <%# Loading indicator. Pinned left as the list is where it hangs from the caller's box (positioned: false):
      absolute with no left, it kept its place after the chips while it took the whole box's width. %>
  <div data-autocomplete-target="loading" hidden class="<%= class_names("ac-loading", "left-0": !positioned) %>">
    <%= fa_icon "spinner", :solid, class: "animate-spin me-1" %>
    Searching…
  </div>

  <%# Results container %>
  <div id="<%= results_id %>"
       data-autocomplete-target="results"
       role="listbox"
       class="<%= class_names("ac-results", results_class, "left-0": !positioned) %>"
       hidden>
  </div>

  <%# Persistent keyboard-shortcut footer. When present, the controller toggles
      this element instead of injecting a duplicate footer into the results. Kept
      inside the controller element so Stimulus binds it as the keyboardHelp
      target. Opt-in (default off) so existing callers are unchanged. %>
  <% if keyboard_help %>
    <div data-autocomplete-target="keyboardHelp"
         class="ac-keyboard-help"
         aria-hidden="true"
         hidden>
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> navigate</span>
      <span><kbd>&crarr;</kbd> select</span>
      <span><kbd>esc</kbd> close</span>
    </div>
  <% end %>
<% end %>

<script async src="https://www.googletagmanager.com/gtag/js?id=<%= gtag %>"></script>
<script>
    window.dataLayer = window.dataLayer || [];

    function gtag() {
        dataLayer.push(arguments);
    }

    gtag('js', new Date());
    // No page_view of its own, which would carry the whole address: the
    // turbo:load handler in application.js sends every one, this page's included.
    gtag('config', '<%= gtag %>', {send_page_view: false});
</script>

<%# locals: (announcements:) %>
<%
  unread = announcements.reject(&:has_read)
  max_display = 5
  display_announcements = unread.first(max_display)
  has_more = unread.size > max_display
%>
<% if unread.any? %>
  <%= ui_card class: "mb-6 p-4", role: "region", aria: { label: "Clubhouse Announcements" } do %>
    <%# Header: title, unread count, and a quiet link to the full list %>
    <div class="flex items-center justify-between gap-3 mb-1">
      <div class="flex-center-gap-2 flex-wrap min-w-0">
        <%= fa_icon "bullhorn", :solid, class: "icon-warning" %>
        <h2 class="heading-section text-heading">Clubhouse Announcements</h2>
        <%= ui_badge unread.size.to_s, :warning, size: "sm", aria: { label: "#{unread.size} unread" } %>
      </div>
      <%= link_to me_announcements_path, class: "inline-flex-center-gap-2 shrink-0 min-h-9 font-medium text-stone-muted hover:text-heading transition-colors" do %>
        View All
        <%= fa_icon "arrow-right", :solid %>
      <% end %>
    </div>

    <%# Each unread announcement is the call to action: subject, then status and dates on one line, and a Read button.
        The row is the link and its text is its name -- no aria-label, so a screen reader hears the subject, the
        status and the action, and "Read Announcement" can be spoken to voice control. %>
    <div class="divide-y divide-line">
      <% display_announcements.each do |announcement| %>
        <% is_expired = announcement.expired? %>
        <%= link_to me_announcements_path(anchor: dom_id(announcement)),
                    class: "flex flex-col lg:flex-row lg:items-center gap-2 lg:gap-4 py-2 px-2 -mx-2 rounded-md hover:bg-base-200 transition-colors no-decoration" do %>
          <div class="flex-1 min-w-0">
            <%# Tracks heading-section's scale so the subject never outweighs the section title %>
            <p class="text-base lg:text-lg font-semibold text-heading <%= "line-through opacity-60" if is_expired %>">
              <%= announcement.subject %>
            </p>
            <%# Status in words and an icon, on every screen size, ahead of the dates %>
            <div class="text-sm text-stone-subtle mt-1">
              <% if is_expired %>
                <span class="font-medium text-stone-muted"><%= fa_icon "clock", :solid %> Expired</span>
              <% else %>
                <span class="font-medium icon-warning"><%= fa_icon "circle-exclamation", :solid %> Unread</span>
              <% end %>
              <span class="mx-1">·</span>
              Posted <%= mdy_format(announcement.created_at) %>
              <% if announcement.expires_at && !is_expired %>
                <span class="mx-1">·</span>
                Expires <%= mdy_format(announcement.expires_at) %>
              <% end %>
            </div>
          </div>

          <%# The span wears the button so the action reads at a glance; pointer-events-none leaves the row's
              hover as the one hover state on the link %>
          <span class="<%= button_classes({ class: "btn-outline pointer-events-none" }, :primary) %>">
            Read Announcement
            <%= fa_icon "arrow-right", :solid %>
          </span>
        <% end %>
      <% end %>
    </div>

    <%# Show more indicator %>
    <% if has_more %>
      <div class="mt-3 pt-3 border-t border-line">
        <%= link_to me_announcements_path, class: "text-stone-muted hover:text-heading transition-colors" do %>
          + <%= unread.size - max_display %> more announcements
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>

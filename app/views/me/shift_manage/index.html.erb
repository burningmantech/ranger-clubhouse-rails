<%= hero_panel icon: "person-walking", heading_level: :h1, id: "shift-manage-header",
               back_to: :dashboard do |panel| %>
  <% panel.title do %>Shift Check In/Out
  <% end %>
  <% panel.description do %>
    <% if @on_duty_entry %>
      On duty as <%= @on_duty_entry.position.title %> since <%= datetime_format @on_duty_entry.on_duty %>.
    <% else %>
      Check in when you start a shift and check out when you finish.
    <% end %>
  <% end %>
<% end %>

<div class="max-w-3xl">
  <%= render partial: "common/shift_manage/check_in_out" %>
</div>

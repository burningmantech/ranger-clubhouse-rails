<div class="flex flex-col items-center justify-center text-center h-full py-4" role="status" aria-label="MVR approved for <%= dashboard.year %>">
  <div class="rounded-full flex items-center justify-center mb-5" aria-hidden="true">
    <%= fa_icon "check", :solid, size: "4x" %>
  </div>

  <h3 class="heading-title text-success mb-2">Approved for <%= dashboard.year %></h3>

  <p class="text-lg text-success max-w-xs mx-auto">
    You are authorized to operate Ranger trucks and SUVs.
  </p>

  <div class="text-stone-muted">
    Authorization is valid for the current event year only.
  </div>
</div>

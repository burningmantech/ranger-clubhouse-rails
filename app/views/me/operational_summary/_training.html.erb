<% training = @person_event.training %>
<% if @person.is_ranger? || @person.is_applicant? %>
  <%= ui_accent_card "In-Person Training is required every event. No exceptions." do %>
    You must complete it before you can Ranger on-playa. If you haven’t, you will be turned away. Advanced Ranger Training
    sessions do not count.
  <% end %>
<% end %>
<%= ui_section "Training", icon: "graduation-cap", icon_type: :solid, class: "mt-4" do %>
  <%= ui_table striped: false do |t| %>
    <%= t.header do %>
      <%= t.heading "Training" %>
      <%= t.heading "Status" %>
      <%= t.heading "When" %>
      <%= t.heading "Where" %>
    <% end %>
    <%= t.body do %>
      <%= t.row do %>
        <%= t.row_header do %>
          Online Course
          <% unless @person_event.online_course_passed %>
            <div class="font-normal text-body mt-1">Complete before signing up for In-Person Training.</div>
          <% end %>
        <% end %>
        <%= t.cell class: "whitespace-nowrap" do %>
          <% if @person_event.online_course_passed %>
            <%= ui_badge "Passed", :success, icon: "circle-check", icon_type: :solid %>
          <% else %>
            <%= ui_badge "Not Passed", :warning, icon: "circle-exclamation", icon_type: :solid %>
          <% end %>
        <% end %>
        <%= t.cell value_or_dash(mdy_format(@person_event.online_course_date)) %>
        <%= t.cell "—" %>
      <% end %>
      <%= t.row do %>
        <%= t.row_header do %>
          In-Person Training
          <%= ui_badge "Teaching", :primary, size: "xs" if training&.is_trainer %>
        <% end %>
        <%= t.cell class: "whitespace-nowrap" do %>
          <%# Required of everyone, so a missing sign-up is an error here, not the shared badge's neutral chip. %>
          <% if training&.status.nil? %>
            <%= ui_badge "Not Available", :secondary, icon: "circle", icon_type: :regular %>
          <% elsif training.status == Training::NO_SHIFT %>
            <%= ui_badge "Not Signed Up", :error, icon: "circle", icon_type: :regular %>
          <% else %>
            <%= render "common/training/status_badge", status: training.status %>
          <% end %>
        <% end %>
        <%= render "me/operational_summary/session_cells", t:, education: training %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

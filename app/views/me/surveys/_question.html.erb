<%# locals: (question:, trainer:, form:) %>
<% field_attr = (trainer ? "question_#{question.id}_#{trainer.id}" : "question_#{question.id}").to_sym %>

<% if question.type == SurveyQuestion::TYPE_TEXT %>
  <%= form.text_area field_attr,
    label: question.description,
    required: question.is_required,
    rows: 4 %>

<% elsif question.type == SurveyQuestion::TYPE_RATING || question.type == SurveyQuestion::TYPE_OPTIONS %>
  <% collection = if question.type == SurveyQuestion::TYPE_RATING
       SurveyAnswer::RATING_OPTIONS.map { |o| [o[:title], o[:id]] }
     else
       question.option_list.map { |o| [o, o] }
     end %>
  <%= form.collection_radio_buttons field_attr, collection, :last, :first,
      { label: question.description, label_position: :stacked, layout: :auto, required: question.is_required },
      question.is_required ? { required: true } : {} %>

<% else %>
  <p class="text-error">
    <%= fa_icon "bug", :solid, class: "icon-error" %>
    Question #<%= question.id %> has an unknown type "<%= question.type %>".
    This is a bug, please report it to the tech team.
  </p>
<% end %>

<%# The add-person search dialog. The search form GETs back into the modal
    frame; each result row is its own add form. trainer_slot_id arrives from
    the controller so the trainee dialog never loads the trainer groups. %>
<% session = @training_session %>
<% adding_trainer = (kind == "trainer") %>

<%= modal_dialog id: "roster-dialog", title: "Add #{adding_trainer ? "Trainer" : "Trainee"} to Session", size: :xl, frame: false do %>
  <% if adding_trainer && session.trainer_groups.empty? %>
    <%= ui_callout_box :error, title: "No Trainer Slots Found" do %>
      There are no matching trainer slots for this session, so no trainer can be added.
      Check that the trainer slots are activated and their descriptions match this session exactly.
    <% end %>
    <%= button_row do %>
      <%= modal_close_button "Close" %>
    <% end %>
  <% else %>
    <%= form_with url: training_session_new_roster_path(training_slug, session.slot.id),
                  method: :get, builder: AppFormBuilder,
                  data: { turbo_frame: "modal" } do |f| %>
      <%= hidden_field_tag :kind, kind %>
      <% if adding_trainer && session.trainer_groups.size > 1 %>
        <%= f.select :trainer_slot_id,
                     options_for_select(session.trainer_groups.map { |g| [g.position_title, g.slot.id] },
                                        trainer_slot_id),
                     { label: "Trainer Position" } %>
      <% elsif adding_trainer %>
        <%= hidden_field_tag :trainer_slot_id, trainer_slot_id %>
      <% end %>

      <%# The search button shares the field's row: a toolbar, not a button_row. %>
      <div class="flex flex-wrap items-end gap-2 mb-3">
        <%= f.text_field :q, label: "Callsign, Name, or Email", value: query, autofocus: true,
                             width: "w-full", wrapper_class: "grow" %>
        <%= submit_button "Search" %>
      </div>
    <% end %>

    <% if results %>
      <% if results.any? %>
        <%= ui_table full_width: true, responsive: false do |t| %>
          <%= t.header do %>
            <%= t.heading "Callsign" %>
            <%= t.heading "Name" %>
            <%= t.heading "Status" %>
            <%= t.heading "Add" %>
          <% end %>
          <%= t.body do %>
            <% results.each do |found| %>
              <%= t.row do %>
                <%= t.row_header found.callsign %>
                <%= t.cell found.desired_full_name %>
                <%= t.cell found.status %>
                <%= t.cell do %>
                  <%# _top: a successful add redirects to the session page, and
                      that visit must replace the WHOLE page (a frame-scoped
                      submit would only blank the dialog and leave the roster
                      stale). Blocked verdicts still 422 back into the frame. %>
                  <%= form_with url: training_session_roster_path(training_slug, session.slot.id),
                                method: :post, builder: AppFormBuilder,
                                data: { turbo_frame: "_top" } do %>
                    <%= hidden_field_tag :person_id, found.id, id: nil %>
                    <%= hidden_field_tag :kind, kind, id: nil %>
                    <% if adding_trainer %>
                      <%= hidden_field_tag :trainer_slot_id, trainer_slot_id, id: nil %>
                    <% end %>
                    <%= submit_button "Add #{found.callsign}", variant: :secondary %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <%= ui_empty_state "No one matched \"#{query}\".", icon: "magnifying-glass", icon_type: :solid %>
      <% end %>
    <% elsif query.present? %>
      <p class="text-stone-muted">Type at least 2 characters and search.</p>
    <% end %>

    <%= button_row do %>
      <%= modal_close_button "Cancel" %>
    <% end %>
  <% end %>
<% end %>

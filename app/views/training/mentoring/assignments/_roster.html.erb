<%# locals: (group:, submitted:, result:, pass_question:, promote_asked:, general_notes:, typed_notes:) %>
<%#
  One mentoring shift: the window it lists, the mentors on it, and its mentees,
  each with mentors, a result, each mentor's notes, and the general notes about
  the mentee with a box for one more, saved together, in any year (ruled
  2026-10-22: a past year's walks are recorded and corrected here too). A
  reader without the trainer role gets the same cards with nothing to change.
  `submitted` holds the rows a refused or questioned save shows again as typed
  (ArtMentoring::Assignment#typed_rows), so the reader keeps their edits, and
  `typed_notes` the general notes typed into it, by person id;
  `pass_question` is what that save is waiting on (nil when nothing), and
  `promote_asked` whether Promote Without a Verdict was pressed with something
  to offer (`promote_offers`).
  `general_notes` are the stored ones, every year's, by person id
  (PersonMentoringNote).
%>
<% editable = can_manage_session? %>
<% mentee_title = @shifts.mentee_position.title %>
<% row_errors = result&.row_errors || {} %>
<%# What a recorded pass can still grant, for the rows already passed. %>
<% pass_left = editable ? @shifts.pass.offers(group.passed) : {} %>

<%# The mentees whose rows were refused, named as the alpha sheet names them. %>
<% failed = group.mentee_entries.filter_map { |entry| entry.person.callsign if row_errors.key?(entry.id) }.uniq %>
<% refusal = if result&.conflict
               "Someone else saved this shift at the same moment. Check the rows below, then save again to record " \
                 "your changes."
             elsif result&.denied
               "#{result.denied} Choose again without that grant, or ask someone who may make it."
             elsif row_errors.any?
               "#{pluralize(row_errors.size, "row")} below still #{row_errors.one? ? "needs" : "need"} fixing" \
                 "#{": #{failed.to_sentence}" if failed.any?}. " \
                 "The shift is saved as a whole, so no part of it was written."
             end %>
<% if refusal %>
  <%= ui_callout_box :error, accent: true, class: "my-4", title: "Nothing Was Recorded" do %><%= refusal %>
  <% end %>
<% end %>

<% if group.unmatched? %>
  <%= ui_callout_box :warning, icon: "triangle-exclamation", icon_type: :solid, accent: true, class: "my-4" do %>
    <strong>No <%= mentee_title %> shift starts within an hour of these sign-ins.</strong>
    Mentees who signed in between <%= art_mentoring_window(group) %> are listed. Their entries may need correcting.
  <% end %>
<% else %>
  <%= ui_callout_box :success, icon: "flag", icon_type: :solid, accent: true, class: "my-4" do %>
    <strong><%= mentee_title %> &mdash; <%= datetime_format(group.begins, group.ends, tz: group.slot.timezone) %>.</strong>
    Mentees signed in to this shift, or between <%= art_mentoring_window(group) %>, are listed.
  <% end %>
<% end %>

<% unless editable %>
  <%= ui_callout_box :info, class: "my-4" do %>
    You can read this shift but not record it. Recording needs the <%= @training.title %> trainer role.
  <% end %>
<% end %>

<%= ui_stat_row do %>
  <%= ui_stat_box group.mentee_entries.size.to_s, "Mentees", icon: "user-group", icon_type: :solid %>
  <%= ui_stat_box group.mentors.size.to_s, "Mentors on Shift", icon: "user-check", icon_type: :solid %>
  <%= art_need_mentor_box(group.needing_mentor.size) %>
  <%= art_awaiting_verdict_box(group.awaiting_verdict.size) %>
<% end %>

<%# How to record the shift: nothing to say to a reader who cannot. %>
<% if editable %>
  <%= ui_disclosure "How This Page Works", variant: :card, class: "my-4" do %>
    <dl class="instruction-list">
      <dt>Who can I pick as a mentor?</dt>
      <dd>
        The mentors signed in around this shift come first, then everyone else holding the
        <%= @shifts.mentor_position&.title || "mentor" %> position. A mentee may have up to
        <%= ArtMentoring::Assignment::MENTOR_SLOTS %> mentors, and a mentor may take several mentees.
      </dd>
      <dt>Can I pair a mentor now and record the result later?</dt>
      <dd>
        Yes. Save with the result left at <%= mentor_result_label(PersonMentor::STATUS_PENDING) %>, and come back once
        the shift is over.
      </dd>
      <% abstained = mentor_result_label(PersonMentor::STATUS_ABSTAIN) %>
      <% not_completed = mentor_result_label(PersonMentor::STATUS_NOT_COMPLETED) %>
      <dt>What do <%= abstained %> and <%= not_completed %> mean?</dt>
      <dd>
        <%= abstained %>: the mentor declined to give a verdict. <%= not_completed %>: the mentee did not complete
        the shift. Neither counts as a pass or a bonk.
      </dd>
      <dt>What does <%= ArtMentoring::Assignment::NO_MENTORS_AVAILABLE %> mean?</dt>
      <dd>
        No mentor could walk with the mentee on this shift. Tick it with every mentor at
        <%= MentorHelper::NO_MENTOR %> and the result at <%= mentor_result_label(PersonMentor::STATUS_PENDING) %>.
        The mentee then no longer counts under Need a Mentor.
      </dd>
      <dt>How do I undo a pairing?</dt>
      <dd>
        Set every mentor to <%= MentorHelper::NO_MENTOR %>, leave the result at
        <%= mentor_result_label(PersonMentor::STATUS_PENDING) %> and every mentor's notes empty, and save.
      </dd>
      <dt>What are general notes?</dt>
      <dd>
        Notes about a mentee for the whole cadre, tied to no mentor, shift or ART. Each one shows on every roster
        the mentee is on, in any ART and any year. Only the person who wrote a note can edit or delete it.
      </dd>
      <dt>What else happens when I record a pass?</dt>
      <dd>
        Someone with the <%= @training.title %> graduate role is asked whether to add the mentee to the
        <%= @shifts.pass.team&.title || "team" %> with its Recommended positions and revoke
        <%= @shifts.pass.revoked_positions.map(&:title).to_sentence %>, or to record the pass alone
        (<%= Training::MentoringHelper::RECORD_PASS_NOT_PROMOTE %>). Without that role nothing is granted, and a
        graduate can finish it later with <%= Training::MentoringHelper::GRANT_TEAM_POSITIONS %>.
      </dd>
      <dt>Can I record a pass with no mentor?</dt>
      <dd>
        Yes. Leave every mentor at <%= MentorHelper::NO_MENTOR %>: you are asked first, then the pass is recorded
        without one.
      </dd>
      <dt>What does <%= Training::MentoringHelper::PROMOTE_WITHOUT_VERDICT %> do?</dt>
      <dd>
        It promotes a mentee without recording a verdict, for someone with the graduate role. Beside Save This
        Shift it saves nothing else typed on this page, so save your changes first.
      </dd>
    </dl>
  <% end %>
<% end %>

<%= ui_section "Mentors on Shift", icon: "user-check", icon_type: :solid do %>
  <% if group.mentor_entries.empty? %>
    <%= ui_empty_state "No mentor has signed in around this shift.", icon: "user-check", icon_type: :solid %>
  <% else %>
    <%= ui_table striped: true do |t| %>
      <%= t.header do %>
        <%= t.heading "Mentor" %>
        <%= t.heading "Signed In" %>
        <%= t.heading "Duration", right: true %>
        <%= t.heading "Mentees This Shift", right: true %>
      <% end %>
      <%= t.body do %>
        <% group.mentor_entries.each do |entry| %>
          <%= t.row do %>
            <%= t.row_header do %><%= person_display_link entry.person, entry.person_id %>
            <% end %>
            <%= t.cell datetime_format(entry.on_duty), class: "whitespace-nowrap" %>
            <%= t.cell art_mentoring_duration(entry), right: true, class: "whitespace-nowrap" %>
            <%= t.cell group.mentee_count_for(entry.person), right: true %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% mentees = capture do %>
  <%= ui_section "Mentees", icon: "person-walking", icon_type: :solid, class: "mt-6",
                 badge: group.mentee_entries.size.to_s do %>
    <%# One card per mentee entry (owner, 2026-11-13: each mentee has several
        parts, which a table's rows and hover misread as separate records). %>
    <% result_options = mentor_result_options(PersonMentor::STATUSES) %>
    <% first_entries = group.first_entries %>
    <div class="space-y-4 pb-2">
      <% group.mentee_entries.each do |entry| %>
        <% walk = group.walk_for(entry) %>
        <% typed = submitted&.dig(entry.id) %>
        <%# Each mentor slot as typed, or as stored: a mentor and their notes. %>
        <% slots = typed ? typed.mentors : walk&.mentors || [] %>
        <% error = row_errors[entry.id] %>
        <% callsign = entry.person.callsign %>
        <% first = first_entries.include?(entry) %>
        <%# The fields share one name scheme, so each carries an explicit
            id: Turbo's morph drops fields whose ids collide. %>
        <%= ui_card id: "walk-#{entry.id}", shadow: :none do %>
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 px-4 pt-3">
            <h3 class="heading-title text-heading"><%= person_display_link entry.person, entry.person_id %></h3>
            <span class="text-stone-muted">
              Signed in <%= datetime_format(entry.on_duty) %> &middot; <%= art_mentoring_duration(entry) %>
            </span>
          </div>
          <%= ui_card_body class: "py-3 space-y-3" do %>
            <%= form_row class: "lg:items-end" do %>
              <%= fields "walks[#{entry.id}]", builder: AppFormBuilder do |wf| %>
                <%= wf.select :status,
                              options_for_select(result_options,
                                                 typed ? typed.status : walk&.status || PersonMentor::STATUS_PENDING),
                              { label: "Result", width: "w-full sm:w-44", wrapper_class: "" },
                              { disabled: !editable, aria: { label: "Result for #{callsign}" } } %>
                <%# The mentee's one box for the shift, on their first entry
                    (PersonMentoringShift; owner, 2026-11-13). %>
                <% if first %>
                  <%= wf.check_box :no_mentors, label: ArtMentoring::Assignment::NO_MENTORS_AVAILABLE,
                                                checked: typed ? typed.no_mentors : group.no_mentors?(entry),
                                                disabled: !editable, wrapper_class: "",
                                                aria: { label: "#{ArtMentoring::Assignment::NO_MENTORS_AVAILABLE} for #{callsign}" } %>
                <% end %>
              <% end %>
              <%# A recorded pass that has not yet joined them to the team or
                  revoked the mentee position: a graduate can finish it here. %>
              <% if editable && pass_left.key?(entry.id) %>
                <% if can_graduate? %>
                  <%= button_action Training::MentoringHelper::GRANT_TEAM_POSITIONS, :secondary,
                                    type: "submit", name: "grant_for", value: entry.id,
                                    icon: "user-plus", icon_type: :solid,
                                    aria: { label: "#{Training::MentoringHelper::GRANT_TEAM_POSITIONS} for #{callsign}" } %>
                <% end %>
              <% end %>
            <% end %>
            <% if editable && pass_left.key?(entry.id) && !can_graduate? %>
              <div class="text-stone-muted">A <%= @training.title %> graduate can add them to the team.</div>
            <% end %>
            <%# Each mentor slot: its select above its notes (owner, 2026-10-28),
                numbered (ruled 2026-10-27), stacked, side by side from lg. The
                hidden fields carry back what the row and each slot held when
                the page was drawn (ArtMentoring::Assignment). %>
            <%= tag.div id: "walk-#{entry.id}-notes-row" do %>
              <%= hidden_field_tag "walks[#{entry.id}][was]",
                                   typed&.was || ArtMentoring::Assignment.stored_fingerprint(walk, group.no_mentors?(entry)) %>
              <div class="stack-to-row-lg">
                <% ArtMentoring::Assignment::MENTOR_SLOTS.times do |i| %>
                  <div class="lg:flex-1">
                    <%= hidden_field_tag "walks[#{entry.id}][mentors][#{i}][loaded_id]", slots[i]&.id %>
                    <%= fields "walks[#{entry.id}][mentors][#{i}]", builder: AppFormBuilder do |mf| %>
                      <%= mf.select :id, art_mentor_choices(group, @shifts.mentor_holders, entry, slots[i]&.id),
                                    { label: "Mentor #{i + 1}", width: "w-full" },
                                    { disabled: !editable, aria: { label: "Mentor #{i + 1} for #{callsign}" } } %>
                      <%= mf.text_area :notes, value: slots[i]&.notes, rows: 3, disabled: !editable,
                                               maxlength: ArtMentoring::Assignment::NOTES_MAX,
                                               label: "Mentor #{i + 1} Notes", wrapper_class: "",
                                               aria: { label: "Mentor #{i + 1} notes for #{callsign}" } %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
            <%# Right under the fields it is about, before the general notes. %>
            <% if error %>
              <%= tag.div id: "walk-#{entry.id}-error", class: "text-error", role: "alert" do %>
                <%= fa_icon "triangle-exclamation", :solid, end: 2 %><%= error %>
              <% end %>
            <% end %>
            <%# The general notes about the mentee and the box for one more, on
                the mentee's first entry only (Shifts::Group#first_entries). %>
            <% notes = general_notes.fetch(entry.person_id, []) %>
            <% if first && (notes.any? || editable) %>
              <%= tag.div id: "walk-#{entry.id}-general-notes-row" do %>
                <%= render "general_notes", notes:, person_id: entry.person_id, callsign:,
                                            typed: typed_notes[entry.person_id], editable: %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if editable %>
  <% unsaved = submitted.present? || typed_notes.present? %>
  <%# A page drawn again with what was typed is still unsaved: the submit that
      brought it back disarmed the guard (unsaved-changes#dirtyValue). %>
  <%= ui_form nil, training_mentoring_assignment_shift_path(training_slug, group.key, year: @year),
              method: :post, local: true, no_error_summary: true,
              data: { controller: "unsaved-changes", unsaved_changes_dirty_value: unsaved } do |f| %>
    <%# First in the form, so Record Pass is its default button: Enter on a
        dialog check box presses it, not an earlier Grant Team Positions. %>
    <%= render "pass_dialog", f:, question: pass_question if pass_question %>
    <%= render("promote_dialog", f:, offers: promote_offers, unsaved:) if promote_asked %>
    <%= mentees %>
    <%= button_row do %>
      <%= f.submit "Save This Shift", data: { turbo_submits_with: "Recording…" } %>
      <%# Promotes without recording a verdict (owner, 2026-10-28): offered to a
          graduate while a mentee on the shift can still gain something. %>
      <% if promote_offers.any? %>
        <%= button_action Training::MentoringHelper::PROMOTE_WITHOUT_VERDICT, :secondary, type: "submit",
                                                                                  name: "promote", value: "ask" %>
      <% end %>
      <%= cancel_link training_mentoring_assignment_path(training_slug, year: @year) %>
    <% end %>
  <% end %>
<% else %>
  <%= mentees %>
<% end %>

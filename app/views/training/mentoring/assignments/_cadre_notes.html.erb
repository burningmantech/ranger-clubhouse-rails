<%# locals: (notes:, person_id:, callsign:, typed:, editable:) %>
<%#
  One mentee's cadre notes on the roster (ruled 2026-10-27): every year's,
  newest first, each with when and by whom, as the app's other note lists show
  them; then, for a reader who can record the shift, the box for one more,
  which the roster's Save writes. `typed` is what a refused or questioned save
  sent for it.
%>
<% field_id = "cadre-note-#{person_id}" %>
<div class="space-y-2">
  <% if notes.any? %>
    <div>
      <%= tag.span "Cadre Notes", class: AppFormBuilder::LABEL_CLASSES %>
      <%= tag.ul class: "space-y-2", aria: { label: "Cadre notes about #{callsign}" } do %>
        <% notes.each do |note| %>
          <li>
            <div class="text-sm text-stone-muted">
              <%= datetime_format(note.created_at, year: true) %> &middot; <%= person_display_name(note.written_by, note.written_by_id) %>
            </div>
            <div class="whitespace-pre-line"><%= note.notes %></div>
          </li>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if editable %>
    <div>
      <%= label_tag field_id, "Add a Cadre Note", class: AppFormBuilder::LABEL_CLASSES %>
      <%= text_area_tag "cadre_notes[#{person_id}]", typed, id: field_id, rows: 2,
                        maxlength: PersonMentoringNote::NOTES_MAX, class: AppFormBuilder::TEXTAREA_CLASSES,
                        aria: { label: "Add a cadre note about #{callsign}", describedby: "#{field_id}-help" } %>
      <%# Both lasting consequences stay in sight here, not only in How This
          Page Works: the note cannot be taken back, and every ART reads it. %>
      <%= tag.p "Saved with the shift, and cannot be changed or deleted after. Shown on every roster this mentee " \
                "is on, in any ART and any year.",
                id: "#{field_id}-help", class: AppFormBuilder::HELP_TEXT_CLASSES %>
    </div>
  <% end %>
</div>

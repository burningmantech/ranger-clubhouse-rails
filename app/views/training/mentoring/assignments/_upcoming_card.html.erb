<%# locals: (shift:) %>
<%# A mentee shift still to come: who signed up for it and for its mentor shift. %>
<%= render "common/mentoring/shift_card",
           title: datetime_format(shift.slot.begins, shift.slot.ends),
           badges: [
             (if shift.needs_mentor?
                ui_badge("No mentor signed up", :warning, icon: "triangle-exclamation", icon_type: :solid)
              end)
           ],
           extra: tag.p("Mentees: #{shift.mentees.any? ? shift.mentees.map(&:callsign).to_sentence : "none yet"}. " \
                        "Mentors: #{shift.mentors.any? ? shift.mentors.map(&:callsign).to_sentence : "none yet"}.",
                        class: "mb-2"),
           url: training_mentoring_assignment_shift_path(training_slug, shift.slot.id, year: @year),
           label: "View Sign-Ups", button: :secondary %>

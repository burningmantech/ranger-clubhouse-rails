<%# locals: (f:, offers:) %>
<%#
  The pass question (ruled 2026-10-21): whether each newly passed mentee also
  joins the training's team, with its Recommended positions, and loses the
  mentee positions. Rendered inside the roster's form, so the answers travel with
  the rows, and opened by the modal controller as soon as it connects.

  Not closable from the backdrop or with Escape: the backdrop is a form of its
  own, and a form cannot sit inside another. Record Pass names itself
  `confirmed`, so only it -- not the page's Save -- answers the question;
  Cancel closes the dialog and leaves every row as it was typed.
%>
<% pass = @shifts.pass %>
<% team = pass.team&.title || "team" %>
<% positions = pass.recommended_positions.map(&:title) %>
<%= modal id: "pass-dialog", closable: false, close_button: false do |m| %>
  <%= m.title(offers.one? ? "Pass #{offers.values.first.person.callsign}" : "Pass #{pluralize(offers.size, "Mentee")}") %>
  <%= m.body do %>
    <p>A pass can also give a mentee their place on the <%= team %>. Nothing is recorded until you choose.</p>
    <% offers.each do |timesheet_id, offer| %>
      <%= f.fieldset offer.person.callsign do %>
        <%= f.check_box "grants[#{timesheet_id}][join]",
                        label: "Add to the #{team}#{" and grant #{positions.to_sentence}" if positions.any?}",
                        checked: offer.join, disabled: !offer.join,
                        help_text: (unless offer.join
                                      if pass.joinable?(offer.person)
                                        "Already a member."
                                      else
                                        "Their status is #{offer.person.status}, so they cannot join a team."
                                      end
                                    end) %>
        <%= f.check_box "grants[#{timesheet_id}][revoke]",
                        label: "Revoke #{(offer.revoke.presence || pass.revoked_positions).map(&:title).to_sentence}",
                        checked: offer.revoke.any?, disabled: offer.revoke.empty?,
                        help_text: offer.revoke.any? ? "Also drops their future sign-ups." : "Holds no mentee position." %>
      <% end %>
    <% end %>
    <%= modal_form_footer f, submit: "Record Pass", name: "confirmed",
                             data: { turbo_submits_with: "Recording…" } %>
  <% end %>
<% end %>

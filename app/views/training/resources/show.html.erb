<% content_for :title, "Trainer Resources" %>

<%= hero_panel icon: "book-open", heading_level: :h1, id: "trainer-resources-header",
               back_to: ["#{@training.title} Sessions", training_path(training_slug)] do |panel| %>
  <% panel.title do %>
    Trainer Resources
  <% end %>
  <% panel.description do %>
    The one document <%= @training.title %> publishes for the people who teach it.
  <% end %>
<% end %>

<%= render "common/resource_documents/document", document: @document, entity: @training,
           edit_path: training_edit_resources_path(training_slug),
           empty_message: "No trainer resource document has been written for #{@training.title} yet." %>

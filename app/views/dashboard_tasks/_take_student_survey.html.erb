<%# locals: (step:,facts:)%>
<%= fa_icon "clipboard-list", :solid %> <b>Quick feedback on your training:</b>
<ul class="list-disc list-inside space-y-2">
<% facts.surveys.sessions.each do |survey| %>
  <li>
    <%= link_to me_surveys_path(slot_id: survey.id, type: survey.type) do %>
      <%= survey.position_title %> - <%= survey.description %> (<%= datetime_format survey.begins, tz: survey.timezone %>)
    <% end %>
  </li>
<% end %>
</ul>

<%# locals: (step:,facts:)%>
<p><%= fa_icon "book", :solid %> Read: <a href="<%= facts.alpha_shift_prep_link %>" target="_blank" rel="noopener noreferrer">Becoming a Ranger: On-playa Alpha Shifts</a></p>

<ul class="my-2 space-y-1">
  <%= ui_icon_item "calendar" do %>
    <b class="text-lg"><%= datetime_format facts.alpha_shift[:begins], tz: facts.alpha_shift[:timezone] %></b>
  <% end %>
  <%= ui_icon_item "clock", tone: "icon-error" do %>
    <span class="text-error font-bold">Arrive 20 minutes early. Late arrivals are turned away.</span>
  <% end %>
  <%= ui_icon_item "location-dot" do %>
    <b>The Hat Rack</b> (right of HQ Windows)<br>
    <span class="text-sm">Ranger HQ: Esplanade &amp; 6:31</span>
  <% end %>
</ul>

<p class="font-semibold">What to expect (~10 hours):</p>
<ul class="list-bulleted mb-2">
  <li>2 hrs review &amp; practice</li>
  <li>6 hrs fieldwork with Mentors (breaks included)</li>
  <li>2+ hrs evaluations (some waiting)</li>
</ul>

<p class="font-semibold">Bring:</p>
<ul class="list-bulleted mb-2">
  <li>Snacks + meal</li>
  <li>Layers, hat, sunglasses, sunscreen</li>
  <li>Comfy walking shoes</li>
  <li>Water bottle</li>
  <li>Pen &amp; notebook</li>
  <li>Flashlight/headlamp (for swing shift 2pm–midnight)</li>
</ul>

<div class="text-base text-stone-muted space-y-1">
  <div>Can't make it? Email Mentor Cadre ASAP or visit Ranger HQ on playa.</div>
  <%= mail_to EmailAddresses::MENTOR_CADRE %>
</div>
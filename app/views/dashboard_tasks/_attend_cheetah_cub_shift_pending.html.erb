<%# locals: (step:,facts:)%>
<p class="text-error font-bold"><%= fa_icon "clock", :solid, class: "icon-error" %> Arrive 15 minutes early. If you're late, you can't walk the shift.</p>
<% if facts.cheetah_cub_shift && facts.cheetah_cub_shift["begins"].present? %>
  <ul class="my-2">
    <%= ui_icon_item "calendar" do %>
      <b><%= datetime_format facts.cheetah_cub_shift["begins"] %></b>
    <% end %>
  </ul>
<% end %>
<p class="text-stone-muted">Can't make it? Email Mentor Cadre or visit Mentor Shack at HQ.</p>
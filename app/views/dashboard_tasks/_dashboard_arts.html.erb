<%# locals: (step:,facts:)%>
<%= ui_table full_width: false, striped: false, responsive: false do |t| %>
  <%= t.header do %>
    <%= t.heading "ART" %>
    <%= t.heading "Status" %>
    <%= t.heading "When/Where" %>
  <% end %>
  <%= t.body do %>
    <% facts.art_trainings.each do |art| %>
      <%= t.row do %>
        <%= t.cell do %>
          <%= art.position_title %>
          <% if art.has_online_course %>
            <br><%= link_to "Go To Online Course", me_online_course_path(art: 1), class: "tap-target-link" %>
          <% end %>
        <% end %>
        <%= t.cell do %>
          <% if art.status == Training::PASS %>
            <%= ui_badge "done", :success %>
          <% elsif [Training::NO_SHOW, Training::FAIL].include?(art.status) %>
            <%= ui_badge "not passed", :error %>
          <% elsif art.status == Training::NO_SHIFT %>
            <%= ui_badge "not signed up", :secondary %>
          <% else %>
            <%= ui_badge "pending", :warning %>
          <% end %>
        <% end %>
        <%= t.cell do %>
          <% if art.slot %>
            <%= datetime_format art.slot.begins %> (<%= art.slot.timezone_abbr %>)<br>
            <%= art.slot.description %>
            <% if art.is_trainer %>
              <br><i>(teaching)</i>
            <% end %>
          <% else %>
            —
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<p class="mt-2"><%= link_to "Go To Schedule / Sign-Ups", me_schedule_path, class: "tap-target-link" %></p>

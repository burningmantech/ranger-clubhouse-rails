<%# HQ wrapper for the shared Available Sign-Ups list. The year option the
    shared template passes is dropped: HQ is locked to the current year (see
    Hq::AvailableSignUpsController#setup_year), so a ?year= on an HQ URL would
    claim something the controller ignores. %>
<%= render template: "common/available_sign_ups/index",
           locals: {
             back_link: back_to("Schedule", hq_scheduling_path(@person)),
             description_text: "Browse available shifts and training sessions for #{@person.callsign}.",
             sign_ups_position_path_builder: ->(position_id, **options) { hq_scheduling_sign_ups_position_path(@person, position_id, **options.except(:year)) }
           } %>

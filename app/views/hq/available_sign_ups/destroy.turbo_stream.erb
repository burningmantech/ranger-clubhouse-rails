<%# HQ wrapper for the shared shift-removal turbo stream. See index.html.erb for
    why the year option is dropped from every path builder. %>
<%= render template: "common/available_sign_ups/destroy",
           locals: {
             schedule_signups_path_builder: ->(slot, **options) { hq_scheduling_signups_path(@person, slot_id: slot.id, **options.except(:year)) },
             sign_up_slot_path_builder: ->(position_id, slot_id, **options) { hq_scheduling_sign_ups_slot_path(@person, position_id:, slot_id:, **options.except(:year)) }
           } %>

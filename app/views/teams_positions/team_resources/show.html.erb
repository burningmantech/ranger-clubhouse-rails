<% content_for :title, @team.title %>

<%= hero_panel icon: "book-open", heading_level: :h1, id: "team-resource-header",
               back_to: ["Team Resources", teams_positions_team_resources_path] do |panel| %>
  <% panel.title do %>
    <%= @team.title %>
  <% end %>
  <% panel.description do %>
    The one document <%= @team.title %> writes for its members.
  <% end %>
<% end %>

<%= render "common/resource_documents/document", document: @document, entity: @team,
           edit_path: teams_positions_edit_team_resource_path(@team),
           empty_message: "No resource document has been written for #{@team.title} yet." %>

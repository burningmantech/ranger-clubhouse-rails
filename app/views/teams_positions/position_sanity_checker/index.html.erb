<%#
  The triage board: nine checks grouped by what the reader has to do about
  them, each drilling into its own page. Checks that found nothing drop to the
  bottom rather than disappearing — a quiet check must not read as a removed one.
%>
<% content_for :title, "Position Sanity Checker" %>

<%= hero_panel icon: "stethoscope", heading_level: :h1,
               id: "position-sanity-checker-header",
               title: "Position Sanity Checker" do |panel| %>
  <% panel.description do %>
    Position, team, and permission grants that contradict each other.
  <% end %>
<% end %>

<% total = @counts.values.sum %>
<% clear = @counts.select { |_key, count| count.zero? }.keys %>

<%= ui_stat_row do %>
  <%= ui_stat_box total.to_s, "Findings in Total",
                  variant: total.zero? ? :success : :error,
                  icon: "triangle-exclamation" %>
  <%= ui_stat_box "#{clear.size} of #{PositionSanityCheck::KEYS.size}", "Checks Clear",
                  variant: clear.size == PositionSanityCheck::KEYS.size ? :success : :secondary,
                  icon: "circle-check" %>
<% end %>

<%# Each band with the checks in it that found something. A band whose every
    check came back clean is left out: its rows are already waiting under Clear
    below, and an empty heading promising work that is not there is worse than
    no heading. The card and the board both read this. %>
<% bands = PositionSanityCheck::BANDS.filter_map do |band|
     keys = PositionSanityCheck.keys_in_band(band).select { @counts[_1].positive? }
     [position_check_band_meta(band), keys] if keys.any?
   end %>

<%# A band's title says what to do, so the card says what is under each one that
    is on the board -- and with every check clear there is no band to explain. %>
<% if bands.any? %>
  <%= ui_disclosure "About This Report", variant: :card, class: "my-4" do %>
    <dl class="instruction-list">
      <% bands.each do |meta, _keys| %>
        <dt>What is under &ldquo;<%= meta[:title] %>&rdquo;?</dt>
        <dd><%= meta[:what] %></dd>
      <% end %>
    </dl>
  <% end %>
<% end %>

<div class="lg:w-3/4 flex flex-col gap-6">
  <% bands.each do |meta, keys| %>
    <section class="flex flex-col gap-2">
      <div class="border-b border-line pb-1">
        <h2 class="heading-section text-heading"><%= meta[:title] %></h2>
      </div>

      <% keys.each do |key| %>
        <% check = position_check_meta(key) %>
        <%= ui_drill_down_row position_check_path(key), check[:label],
                              icon: "arrow-right",
                              meta: check[:summary],
                              badges: [position_check_badge(@counts[key], size: "base")] %>
      <% end %>
    </section>
  <% end %>

  <% if clear.any? %>
    <section class="flex flex-col gap-2">
      <div class="border-b border-line pb-1">
        <h2 class="heading-section text-heading">Clear</h2>
        <p class="text-sm text-stone-muted">
          <%= pluralize(clear.size, "check") %> found nothing.
        </p>
      </div>

      <% clear.each do |key| %>
        <% check = position_check_meta(key) %>
        <%= ui_drill_down_row position_check_path(key), check[:label],
                              class: "opacity-75",
                              meta: check[:summary],
                              badges: [position_check_badge(0, size: "base")] %>
      <% end %>
    </section>
  <% end %>
</div>

<%# locals: (warnings:, start_time:, finish_time:, lead_in:) %>
<% if warnings && warnings.status == "out-of-range" %>
  <%= ui_callout_box :warning, icon: "hand" do %>
    <%= lead_in %>
    <ul class="list-bulleted mt-2 space-y-1">
      <% { "On Duty" => [start_time, warnings.start_status],
           "Off Duty" => [finish_time, warnings.finished_status] }.each do |label, (time, status)| %>
        <% next if status == "success" || time.blank? %>
        <li>
          The <%= label %> time <%= datetime_format time %>
          <% if status == "before-begins" %>
            <strong>is before the very first shift of the event</strong>
            starting on <%= datetime_format warnings.begins %>.
          <% else %>
            <strong>is after the very last shift of the event</strong>
            ending on <%= datetime_format warnings.ends %>.
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>

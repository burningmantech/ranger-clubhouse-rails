<%= hero_panel icon: "handshake", heading_level: :h1, id: "mentoring-header",
               description: "#{description_text}", back_to: back_link do |panel| %>
  <% panel.title do %>Mentoring
  <% end %>
<% end %>

<%# Nothing here works without an Alpha year: the status form needs one too. %>
<% if @mentoring.year %>
<%= ui_section "#{@mentoring.year} Alpha Shift Mentors", icon: "person-walking", icon_type: :solid do %>
  <%= mentor_card_row do %>
    <% @mentoring.mentors.each do |mentor| %>
      <%= render "common/mentoring/mentee_card",
                 name: (link_to_person ? link_to(mentor.callsign, person_path(mentor.id)) : mentor.callsign),
                 avatar: mentor.avatar, badge: nil, contact: send_message_path_builder.present?,
                 message_path: (send_message_path_builder.call(mentor.callsign) if send_message_path_builder && mentor.can_message?) do %>
      <% end %>
    <% end %>
  <% end %>

  <% if status_form_path_builder && can_edit_status %>
    <% form_model = (defined?(@form) && @form) || PersonMentorStatusForm.new(
      mentor_year: @mentoring.year,
      status: @mentoring.current_status
    ) %>
    <div class="mt-4">
      <%= ui_form(form_model,
                  status_form_path_builder.call(@mentoring.year),
                  method: :patch) do |f| %>
        <%= f.hidden_field :mentor_year %>
        <%= form_row do %>
          <%= f.select :status,
                       PersonMentor::STATUSES.map { |s| [s.titleize, s] },
                       {},
                       label: "Status (applies to all Alpha mentor records for #{@mentoring.year})" %>
        <% end %>
        <%= f.submit "Save Status" %>
      <% end %>
    </div>
  <% end %>
<% end %>
<% end %>

<% @mentee_events.each do |event| %>
  <%= ui_section "#{event.year} Alpha Shift Mentees (#{pluralize event.alphas.size, "alpha"})", icon: "users", icon_type: :solid do %>
    <%= mentor_tally_row do %>
      <%= ui_badge "#{event.passed} passed", :success %>
      <% if event.bonked > 0 %>
        <%= ui_badge "#{event.bonked} bonked", :error %>
      <% end %>
    <% end %>
    <%= mentor_card_row do %>
      <% event.alphas.each do |alpha| %>
        <%= render "common/mentoring/mentee_card",
                   name: (link_to_person ? link_to(alpha.callsign, person_path(alpha.id)) : alpha.callsign),
                   avatar: alpha.avatar, badge: mentor_result_badge(alpha.mentor_status),
                   contact: send_message_path_builder.present?,
                   message_path: (send_message_path_builder.call(alpha.callsign) if send_message_path_builder && alpha.can_message?) do %>
          <%= ui_card_section "Mentors" do %>
            <% alpha.mentors.each do |mentor| %>
              <span class="wrap-break-word"><%= mentor.callsign %></span><br>
            <% end %>
          <% end %>
          <%= ui_card_section "Last Rangered" do %>
            <% if alpha.last_worked.present? %>
              <%= alpha.last_worked %>
            <% else %>
              <i>never</i>
            <% end %>
          <% end %>
          <% if alpha.fkas.any? %>
            <%= ui_card_section "FKAs" do %>
              <% alpha.fkas.each do |fka| %>
                <span class="break-words"><%= fka %></span><br>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% @art_history.sections.each do |section| %>
  <%= render "common/mentoring/art_section", section:, link_to_person:, send_message_path_builder: %>
<% end %>

<% if @mentoring.year.nil? && @mentee_events.empty? && @art_history.sections.empty? %>
  <%= ui_empty_state "No mentoring records to show." %>
<% end %>

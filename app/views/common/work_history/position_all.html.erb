<%= hero_panel icon: "clock-rotate-left", heading_level: :h1, id: "work-history-breakdown-header",
               title: "#{@position.title}",
               description: "Timesheet entries for #{@person.callsign}.",
               back_to: ["Work History", url_for(action: :index)] %>

<%= ui_stat_row do %>
  <%= ui_stat_box @position.years.size.to_s, (@position.years.size == 1 ? "Year" : "Years") %>
  <%= ui_stat_box hour_format(@position.duration), "Total Hours" %>
<% end %>

<%= ui_section "Hours Breakdown", icon: "clock", icon_type: :solid do %>
  <div class="space-y-4">
    <% @position.years.each do |year, event| %>
      <div>
        <%= ui_subheading do %>
          Event Year <%= year %>
          <span class="text-stone-muted font-normal">(<%= hour_format(event.duration) %> hours)</span>
        <% end %>
        <%= ui_table responsive: false do |t| %>
          <%= t.header do %>
            <%= t.heading "Time" %>
            <%= t.heading "Hours", right: true %>
            <%= t.heading "Credits", right: true %>
          <% end %>
          <%= t.body do %>
            <% event.entries.each do |entry| %>
              <%= t.row do %>
                <%= t.cell do %>
                  <%= datetime_format(entry.on_duty, entry.off_duty || Current.time) %>
                  <% if entry.is_echelon %>
                    <div class="text-stone-muted text-sm">(as Echelon volunteer)</div>
                  <% end %>
                <% end %>
                <%= t.cell hour_format(entry.duration), right: true %>
                <%= t.cell "%.2f" % entry.credits, right: true %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

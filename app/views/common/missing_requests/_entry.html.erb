<%# locals: (entry:) %>

<%= ui_card class: "my-2 overflow-hidden" do %>
  <% if entry.status_approved? %>
    <%= ui_callout_box :success do %>
      The correction request has been approved. Please review the new timesheet entry for accuracy.
    <% end %>
  <% elsif entry.status_pending? %>
    <%= ui_callout_box :warning do %>
      The requested corrections are pending review.
    <% end %>
  <% elsif entry.status_rejected? %>
    <%= ui_callout_box :error do %>
      <% if timesheet_self_serve? %>
        The submitted corrections request has been denied. You may submit an appeal. If you do not wish to do so,
        the entry still needs to be verified to indicate no further correction requests will be submitted for this
        entry.
      <% else %>
        The submitted corrections request has been denied. <%= timesheet_person.callsign %> may submit an appeal.
        Otherwise, the entry still needs to be verified to indicate no further correction requests will be submitted
        for this entry.
      <% end %>
    <% end %>
  <% else %>
    <%= ui_callout_box :error do %>
      Uh oh, a bug has been tripped over.
    <% end %>
  <% end %>

  <div class="p-3">
    <div class="lg:flex lg:gap-2">
      <div class="lg:w-50"><%= entry.position.title %></div>
      <div><%= hour_minute_words entry.duration %></div>
      <div><%= credit_format entry.credits %></div>
    </div>
    <%= datetime_format entry.on_duty, entry.off_duty %>
    <% if entry.notes.any? %>
      <div class="my-2">
        Last note left from <%= entry.notes.last.from_label(current_user.id) %>
        at <%= datetime_format entry.notes.last.created_at %>
      </div>
    <% end %>

    <% if entry.notes.any? %>
      <%= ui_disclosure "Notes (#{entry.notes.size})", class: "mt-2" do %>
        <%= render partial: "common/timesheet_notes", locals: { notes: entry.notes } %>
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= button_row do %>
        <% if entry.status_pending? || entry.status_rejected? %>
          <%= button_link((entry.status_pending? ? "Add More Info" : "Add Appeal"), :secondary, timesheet_edit_missing_request_path(entry)) %>
        <% end %>
        <% unless entry.status_approved? %>
          <%= delete_button timesheet_missing_request_path(entry), "Delete Request", confirm: "this request" %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>

<%# locals: (entries:) %>
<% if entries.any? %>
  <% entries.each do |entry| %>
    <div class="box box-default mb-3 p-4 rounded-xl border border-line shadow-sm" aria-labelledby="entry-<%= entry.id %>-title">
      <%= render layout: "common/entry_card_grid", locals: {
            title: entry.position.title,
            duration: entry.duration,
            credits: entry.credits,
            title_id: "entry-#{entry.id}-title",
            description: nil
          } do %>
          <% if entry.off_duty %>
            <%= datetime_format entry.on_duty, entry.off_duty %>
          <% else %>
            <%= datetime_format entry.on_duty %>  (<span class="italic text-stone-subtle">still on duty</span>)
          <% end %>
      <% end %>

      <% unless entry.position.count_hours %>
        <div class="mt-3 me-muted">
          Note: Hours served in this position do not qualify for provisions (meals, showers, clothing, or an event
          radio).
          This applies to provisions only and does not affect <%= timesheet_whose %> credit earnings or ticket eligibility.
        </div>
      <% end %>
    </div>
  <% end %>
<% else %>
  <%= ui_empty_state "No timesheet entries were recorded for #{@year}.", icon: "clipboard-list", icon_type: :solid %>
<% end %>

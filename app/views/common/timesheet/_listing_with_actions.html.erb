<%# locals: (entries:) %>

<% entries.each do |entry| %>
  <%# The card is inside the partial, so a turbo_stream.update of this frame
      (TimesheetCorrectionsConcern) redraws it whole. %>
  <%= turbo_frame_tag "entry-#{entry.id}" do %>
    <%= render partial: "common/timesheet/entry_with_action", locals: { entry: } %>
  <% end %>
<% end %>

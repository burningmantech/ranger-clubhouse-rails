<%# locals: (up_url:, down_url:, label:, first:, last:) %>
<%# Up and down one place in the line. At either end the arrow becomes an
    empty slot the same size rather than a greyed one: a disabled attribute
    does nothing to a link, and the slot keeps the other buttons under the
    pointer between clicks. The size classes sit on the buttons themselves, so
    the tap target is 36px square: btn-square, because an icon is all a button
    holds. With its side padding the button was 41px wide against the slot's
    36px, which put the first row's down arrow out of line with the others. %>
<% if first %>
  <span class="inline-block min-h-9 min-w-9" aria-hidden="true"></span>
<% else %>
  <%= button_link nil, :secondary, up_url, method: :patch, class: "btn-square",
                  icon: "arrow-up", icon_type: :solid, title: "Move up" do %>
    <span class="sr-only">Move <%= label %> up</span>
  <% end %>
<% end %>
<% if last %>
  <span class="inline-block min-h-9 min-w-9" aria-hidden="true"></span>
<% else %>
  <%= button_link nil, :secondary, down_url, method: :patch, class: "btn-square",
                  icon: "arrow-down", icon_type: :solid, title: "Move down" do %>
    <span class="sr-only">Move <%= label %> down</span>
  <% end %>
<% end %>

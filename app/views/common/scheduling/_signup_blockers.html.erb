<%# locals: (permission:) %>
<%
  only_training = permission.requirements.empty? && !permission.training_signups_allowed
%>
<%= ui_alert_banner (only_training ? "In-Person Training Warning" : "Sign-Ups Blocked"), :error do %>
  <% if only_training %>
    <div class="space-y-4">
      <div class="flex gap-3">
        <div class="shrink-0 icon-error text-xl">
          <%= fa_icon "circle-exclamation", :solid %>
        </div>
        <div>
          <h4 class="heading-title mb-1">Online Course Required</h4>
          You must complete the Online Course before you can sign up for any In-Person Training. This does <b>not</b>
          apply to Advanced Ranger Trainings.
        </div>
      </div>

      <div class="flex gap-3">
        <div class="shrink-0 icon-warning text-xl">
          <%= fa_icon "info-circle", :solid %>
        </div>
        <div>
          <h4 class="heading-title mb-1">Shift Sign-Ups</h4>
          <p>
            You may sign up for shifts at any time, but you cannot ranger on playa until you have attended and passed an
            In-Person Training.
          </p>
        </div>
      </div>
      <%= ui_accent_card "Waiting for Course Completion", variant: :info, icon: :clock, icon_type: :regular do %>
        <p class="mb-2">
          Just finished the course? The Clubhouse can take up to 30 minutes to reflect completion.
        </p>
        If it has been more than 2 hours, email the Training Academy: <%= mail_to EmailAddresses::TRAINING_ACADEMY %>
      <% end %>
    </div>
  <% else %>
    <div class="flex gap-3 mb-4">
      <div class="shrink-0 text-error text-xl">
        <%= fa_icon "ban", :solid %>
      </div>
      <div>
        <h4 class="heading-title mb-2">Action Required</h4>
        <p class="mb-2">
          Before being allowed to sign up for any shift (including In-Person Training sessions), the following issue(s)
          must be resolved:
        </p>
        <ul class="list-inside list-disc space-y-1 pl-1 font-medium text-error">
          <% permission.requirements.each do |requirement| %>
            <li><%= Scheduling::REQUIREMENT_LABELS[requirement] || "Unknown status #{requirement}" %></li>
          <% end %>
        </ul>
      </div>
    </div>

    <% unless permission.training_signups_allowed %>
      <div class="mt-4 pt-4 border-t border-line">
        <p class="mb-1 font-semibold">Need assistance?</p>
        <%= mail_to EmailAddresses::TRAINING_ACADEMY, "Contact Training Academy", class: "inline-flex-center-gap-2 icon-warning hover:underline" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%# locals: (verdict:)%>
<%= ui_callout_box :warning,
                title: "Linked Shifts Now Full",
                icon: "users", accent: true do %>
  <dl class="instruction-list">
    <dt>What happened?</dt>
    <dd>
      Your sign-up filled the last spot. This shift shares a
      <strong>combined <%= pluralize verdict.combined_max, "sign-up" %></strong>
      limit with the linked <%= "shift".pluralize(verdict.linked_slots.size) %> below.
    </dd>

    <dt><%= verdict.linked_slots.one? ? "Which shift is linked?" : "Which shifts are linked?" %></dt>
    <dd>
      <ul class="list-bulleted space-y-1">
        <% verdict.linked_slots.each do |linked| %>
          <li><%= linked.slot.position.title %></li>
        <% end %>
      </ul>
    </dd>

    <dt>Can anyone else sign up?</dt>
    <dd>No. No more sign-ups are allowed for any of these shifts.</dd>
  </dl>
<% end %>

<% if @corrections_enabled %>
  <% if @have_outstanding %>
    <%# STATE 1: Action Required - Timesheet Review %>
    <%= ui_alert_banner "Action Required: Timesheet Review", :warning do %>
      <div class="mb-4">
        <p class="mb-2">
          Review your timesheet to receive proper credit for your <%= Current.year %> Ranger hours.
        </p>
      </div>

      <%# Clear action list - verb-first, specific numbers %>
      <div class="mb-4">
        <%# No text-heading: .box-accent-warning paints its own descendants %>
        <h3 class="heading-title mb-2">Tasks to Complete</h3>
        <ul class="space-y-1">
          <% if @timesheets_unverified.positive? %>
            <%= ui_icon_item "circle-check", :regular do %>
              <strong>Verify <%= pluralize @timesheets_unverified, "entry" %></strong> — Review and mark as correct or submit corrections
            <% end %>
          <% end %>
          <% if @timesheets_pending.positive? %>
            <%= ui_icon_item "clock", :regular do %>
              <strong>Wait for <%= pluralize @timesheets_pending, "correction request" %></strong> — Timesheet Wranglers are reviewing
            <% end %>
          <% end %>
          <% if @missing_requests_pending.positive? %>
            <%= ui_icon_item "clock", :regular do %>
              <strong>Wait for <%= pluralize @missing_requests_pending, "missing entry request" %></strong> — Timesheet Wranglers are reviewing
            <% end %>
          <% end %>
          <%# A rejected missing entry request keeps the review open too
              (TimesheetConcern), so it needs a task of its own. %>
          <% if @missing_requests_rejected.positive? %>
            <%= ui_icon_item "circle-xmark", :regular do %>
              <strong>Review <%= pluralize @missing_requests_rejected, "rejected missing entry request" %></strong> — Appeal or delete each one
            <% end %>
          <% end %>
        </ul>
      </div>

      <%# Collapsible help section %>
      <div class="mt-4 border-t border-line pt-3">
        <%= ui_accordion(
              safe_join([fa_icon("circle-question", :solid, end: 2), "Common Questions"]),
              content_class: "px-2 pt-3"
            ) do %>
          <dl class="instruction-list">
            <dt>Missing a timesheet entry?</dt>
            <dd>Use the "Missing Requests" button to submit missing timesheet entry requests.</dd>
            <dt>What happens after I complete all tasks?</dt>
            <dd>Once all tasks are complete, a "Confirm Final Confirmation" button will appear.</dd>
            <dt>Why is this important?</dt>
            <dd>Verified timesheets ensure you receive proper credit and qualify for tickets and provisions.</dd>
          </dl>
        <% end %>
      </div>
    <% end %>

  <% elsif @final_confirmation %>
    <%# STATE 2: Success - All Done %>
    <%= ui_alert_banner "Timesheet Review Completed", :success do %>
      <div class="mb-3">
        <p class="text-base font-semibold">
          <%= fa_icon "circle-check", :solid, class: "icon-success" %> All timesheet tasks
          completed!
        </p>
        <p class="mt-2">
          Your entries are verified, and you've confirmed you're done rangering for <%= Current.year %>.
          There's nothing else you need to do.
        </p>
      </div>

      <%# Collapsible "what if" section %>
      <div class="mt-4 border-t border-line pt-3">
        <%= ui_accordion(
              "Making Changes Later",
              content_class: "px-2 pt-2"
            ) do %>
          <p>
            Need to make changes later? You can submit correction requests anytime. You'll just need to complete the Final
            Confirmation step again after those requests are processed.
          </p>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <%# STATE 3: Final Confirmation Required %>
    <%= ui_alert_banner "Action Required: Final Confirmation", :error do %>
      <div class="mb-4">
        <p>
          All timesheet entries are verified. No correction requests are pending.
        </p>
      </div>

      <%# Clear decision tree %>
      <h3 class="heading-title mb-3 text-heading">Choose One</h3>

      <div class="mb-2">
        <%= render layout: "common/icon_block",
                   locals: { icon: "calendar-days", icon_class: "text-lg" } do %>
          <p class="font-semibold">Still have more shifts planned?</p>
          <p class="mt-1">Come back after your shifts to confirm. Timesheet Reviewers will
            follow up if not completed after the event.</p>
        <% end %>
      </div>
      <%= render layout: "common/icon_block",
                 locals: { icon: "check-circle", icon_class: "text-lg" } do %>
        <p class="font-semibold">Finished volunteering for this event?</p>
        <p class="mt-1 mb-3">Click below to confirm you won't submit more
          corrections.</p>
        <%= button_link "Confirm Final Confirmation", :primary, final_confirmation_me_timesheet_index_path, full_width: true %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

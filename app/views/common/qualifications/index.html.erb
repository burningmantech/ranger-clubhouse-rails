<%= hero_panel icon: "ticket", heading_level: :h1, id: "qualifications-header",
               description: "Track your progress toward earning tickets, meals, clothing, and showers.",
               back_to: [@back_to_label, @back_to_url] do |panel| %>
  <% panel.title do %>Qualifications
  <% end %>
<% end %>

<% step = @qualifications.next_step %>
<% all_earned = @qualifications.all_earned? %>
<% closed_out = @qualifications.closed_out? %>

<%# Reference goes in the page's one collapsed card; the warning stays visible. %>
<%= ui_disclosure "About This Report", variant: :card, class: "my-4" do %>
  <dl class="instruction-list">
    <dt>Are these hours final?</dt>
    <dd>No. Sign-ups show potential hours. Actual earnings are based on time on duty.</dd>
    <% if @ineligible_duration.present? %>
      <dt>Do all my hours count?</dt>
      <dd>
        No. <%= hour_minute_words @ineligible_duration %> of your volunteer hours do not count toward provisions
        (e.g. training sessions).
      </dd>
    <% end %>
    <dt>When is eligibility final?</dt>
    <dd>Final eligibility is confirmed after all timesheets are verified.</dd>
  </dl>
<% end %>

<%# A notice, so its title stays a div (no heading_level). %>
<%= ui_accent_card "Important: Items Are Non-Transferable", variant: :warning, icon: "circle-info",
                   options: { id: "qualifications-important", class: "mb-4" } do %>
  Items cannot be sold or transferred. Attempting to do so results in revocation.
<% end %>

<%# Green once every goal is earned, even while an upper tier still offers a step;
    neutral once nothing open is left to earn this year.
    Divs, not <p>s: the base paragraph margin would swallow mt-1 and pad the card unevenly. %>
<%= ui_accent_card "Next Step", variant: (all_earned ? :success : (closed_out ? :secondary : :primary)),
                                icon: "flag-checkered",
                                heading_level: :h2,
                                options: { id: "qualifications-next-step", class: "mb-4" } do %>
  <div class="text-lg text-heading">
    <% if step %>
      <%= qualification_next_step step %>
    <% elsif all_earned %>
      You have earned everything available this year.
    <% elsif closed_out %>
      Nothing still open can be earned this year.
    <% else %>
      Your sign-ups cover everything still open. Ranger those shifts to earn it.
    <% end %>
  </div>
  <% unless all_earned %>
    <div class="mt-1 text-base text-stone-subtle tabular-nums"><%= qualification_goal_counts @qualifications.goal_counts %></div>
  <% end %>
  <% if step %>
    <%= button_link "View Available Sign-Ups", :primary, @signups_url, icon: "calendar-plus", icon_type: :solid,
                    class: "mt-3" %>
  <% end %>
<% end %>

<%# Each section's note closes it, under the rows it governs; its rule line opens it (qualification_section). %>
<% note_class = "border-t border-base-300 pt-2 text-base text-stone-subtle" %>

<div class="grid gap-x-4 lg:w-7/10">
  <%= qualification_section "Tickets", @qualifications.section_state(:tickets) do %>
    <% if @qualifications.visible?(:spt) %>
      <%= render "common/qualifications/qualification_row", item: @qualifications[:spt],
                 description: "Reduced-price paper ticket. Vehicle pass available to purchase." %>
    <% end %>
    <%= render "common/qualifications/qualification_row", item: @qualifications[:staff_credential],
               description: "Free wristband + free Vehicle Pass. Wristband is the ticket. Will Call pickup only." %>
    <p class="<%= note_class %>">
      You will receive only one ticket type (Staff Credential supersedes Special Price Ticket). Vehicle Passes are
      attached to tickets and cannot be bought separately.
    </p>
  <% end %>

  <%= qualification_section "Meal Passes", @qualifications.section_state(:meal_passes) do %>
    <% if @qualifications.visible?(:event_week_eats) %>
      <%= render "common/qualifications/qualification_row", item: @qualifications[:event_week_eats],
                 description: "3 meals/day at the commissary. Event Week only.",
                 subtext: "Event Week hours only" %>
    <% end %>
    <%= render "common/qualifications/qualification_row", item: @qualifications[:all_eats],
               description: "3 meals/day at the commissary. Pre-Event + Event Week + Post-Event.",
               subtext: "combined Pre-Event + Event Week + Post Event hours" %>
    <p class="<%= note_class %>">
      You get one pass type only (All Eats supersedes Event Week). Present your BMID at the commissary.
    </p>
  <% end %>

  <%= qualification_section "Ranger Clothing", @qualifications.section_state(:ranger_clothing) do %>
    <% if @qualifications.shiny_penny? %>
      <%= ui_callout_box :warning, title: "Welcome, Shiny Penny!", icon: "star", heading_level: :h3 do %>
        You are not eligible for additional clothing this year. You will be eligible starting next year.
      <% end %>
    <% else %>
      <%= render "common/qualifications/qualification_row", item: @qualifications[:t_shirt],
                 subtext: "combined Pre-Event & Event Week hours only" %>
      <%= render "common/qualifications/qualification_row", item: @qualifications[:long_sleeve_shirt],
                 subtext: "combined Pre-Event & Event Week hours only" %>
    <% end %>
  <% end %>

  <%= qualification_section "Showers", @qualifications.section_state(:showers) do %>
    <%= render "common/qualifications/qualification_row", item: @qualifications[:shower_pog],
               description: "One-time shower access for this event only. Non-transferable.",
               subtext: "Event week hours only" %>
    <%= render "common/qualifications/qualification_row", item: @qualifications[:shower_access_event_week],
               subtext: "Event Week hours only" %>
    <% if @qualifications.visible?(:shower_access_entire_event) %>
      <%= render "common/qualifications/qualification_row", item: @qualifications[:shower_access_entire_event],
                 subtext: "combined Pre-Event + Event Week + Post Event hours" %>
    <% end %>
    <p class="<%= note_class %>">
      Daily shower access during Pre-Event, Event Week, and Post-Event, linked to your BMID. Only one path required:
      Event Week hours, or Combined hours (Pre + Event + Post).
    </p>
  <% end %>
</div>

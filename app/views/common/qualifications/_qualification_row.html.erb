<%# locals: (item:, description: nil, subtext: nil) %>
<% name = qualification_name(item) %>
<%# Settled: earned, or closed for the year with nothing on track -- the name steps back and the estimate is spent either way %>
<% settled = item.has_earned || (item.closed && !item.expected_to_earn) %>
<% variant = qualification_bar_variant(item) %>
<%# Every row keeps its top rule: the section's rule line (qualification_section) sits above the first one %>
<div class="grid content-start gap-2 border-t border-base-300 py-4" id="qual-<%= item.name %>-title">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <div class="flex items-baseline gap-2 <%= settled ? "font-medium text-stone-subtle" : "font-semibold text-heading" %>">
      <span class="w-5 shrink-0 text-center"><%= qualification_icon item %></span>
      <span><%= name %></span>
    </div>
    <%# ms-7: when the step wraps under the name, it lines up with the name, not the icon %>
    <div class="ms-7">
      <% if item.has_earned %>
        Earned
      <% elsif item.expected_to_earn %>
        On track
      <% elsif item.closed %>
        Not earned this year
      <% else %>
        Sign up for <strong class="font-bold text-heading tabular-nums"><%= qualification_amount item.needs_to_schedule %></strong> more
      <% end %>
    </div>
  </div>

  <%# Time on duty is what earns the award, so its bar leads every row, the earned and closed ones included %>
  <%= render "common/qualifications/track", lead: true, label: "On Duty",
             figure: qualification_done(item), tail: "of #{hq_threshold_display(item)} #{qualification_unit item}",
             percentage: item.percentage, variant:, aria_label: "#{name} on duty" %>

  <%# Sign-ups are an estimate until rangered: a hatched bar of its own, spent once the award is earned or
      can no longer be earned this year (a closed counter takes no more hours, so no sign-up helps) %>
  <% unless settled %>
    <%= render "common/qualifications/track", hatched: true, label: "With Sign-Ups",
               figure: qualification_amount(item.expected_total),
               tail: "with #{qualification_amount item.scheduled} signed up, estimate",
               percentage: item.projected_percentage, variant:, aria_label: "#{name} with sign-ups, estimate" %>
  <% end %>

  <%# Divs, not <p>s: the base paragraph margin would leave rows with notes taller than rows without.
      Eligibility shows on every row, earned ones included: it names the hours the On Duty figure counts,
      which differ by row (Event Week only, or Pre-Event + Event Week + Post-Event). %>
  <% if description %>
    <div class="text-base text-stone-subtle"><%= description %></div>
  <% end %>
  <% if subtext %>
    <div class="text-base text-stone-subtle">Eligibility: <%= subtext %></div>
  <% end %>
</div>

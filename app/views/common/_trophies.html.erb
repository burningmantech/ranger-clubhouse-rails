<%# locals: (title:,icon:,icon_type:,trophies:, entity:) %>
<h3 class="mt-4 mb-2 heading-title text-heading"><%= fa_icon icon, icon_type, end: 2 %><%= title %></h3>
<% if trophies.empty? %>
  <%= ui_empty_state "No #{entity} awards have been granted yet." %>
<% else %>
  <div class="flex flex-col lg:flex-row lg:flex-wrap gap-4">
    <% trophies.each do |trophy| %>
      <%# Nothing in a card outweighs the h3 above it: the title and the award
          years are semibold at the body size, the icon neutral. %>
      <%= ui_card class: "p-3 text-center" do %>
        <div class="font-semibold text-heading">
          <%= fa_icon(:award, :solid, class: "text-stone-icon", end: 2) %><%= trophy[:title] %>
        </div>
        <div class="font-semibold text-heading">
          <%= year_range trophy[:years] %>
        </div>
        <div class="py-2">
          <div class="text-stone-muted font-semibold mb-1">Service Years</div>
          <div class="text-body"><%= trophy[:service_years].empty? ? "—" : year_range(trophy[:service_years]) %></div>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# locals: (title:,icon:,icon_type:,trophies:, entity:) %>
<h3 class="mt-4 mb-2 heading-title text-heading"><%= fa_icon icon, icon_type, end: 2 %><%= title %></h3>
<% if trophies.empty? %>
  <div class="empty-state text-lg" role="status">
    No <%= entity %> awards have been granted yet.
  </div>
<% else %>
  <% badge = capture do %>
    <div class="bg-warning/10 icon-warning mb-2 ring-1 ring-signature-edge">
      <%= fa_icon(:award, :solid) %>
    </div>
  <% end %>
  <div class="flex flex-col lg:flex-row lg:flex-wrap gap-4">
    <% trophies.each do |trophy| %>
      <div class="border rounded p-2">
        <div class="flex flex-row gap-2 text-lg text-center">
          <%= badge %>
          <div><%= trophy[:title] %></div>
          <%= badge %>
        </div>
        <div class="text-lg text-center font-bold text-heading">
          <%= year_range trophy[:years] %>
        </div>
        <div class="text-center py-2">
          <% if !trophy[:service_years].empty? %>
            <div class="text-sm uppercase tracking-wider me-muted font-semibold mb-1">Service Years</div>
            <div class="text-body"><%= year_range trophy[:service_years] %></div>
          <% else %>
            <span class="text-sm me-muted italic">no service years<br>recorded</span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

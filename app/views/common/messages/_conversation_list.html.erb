<%# locals: (messages:,folder:,selected_id: nil) %>
<% if searching? %>
  <%# In the tab row's place: what the search found, and the way back to the
      folder, as a fresh page so the field and its chips empty too. It is no
      menu link (active_ignore): the bare mailbox path it goes to is the page
      it is on, so active_links_controller would mark it current, pressed and
      read as "current page", on every whole load of a search (Back, a reload).
      A search with no hits says so in the empty state below instead. %>
  <% summary = message_search_summary(messages.size, search_query, search_with) %>
  <%= tag.div class: "flex flex-wrap items-center gap-2 px-3 text-stone-muted", role: ("status" if messages.any?) do %>
    <% if messages.any? %><span><%= summary %></span><% end %>
    <%= button_link "Clear Search", :ghost, messages_path(folder: (folder unless folder == PersonMessage::FOLDER_INBOX)),
                    class: "ms-auto", data: { turbo_frame: "_top", active_ignore: true } %>
  <% end %>
<% end %>
<% if messages.empty? %>
  <%= ui_empty_state searching? ? summary : "No messages in this folder.", icon: "envelope", class: "mx-3 text-center" %>
<% end %>
<% if messages.any? %>
  <%# data-search shows what only a search's rows show (_conversation_summary's Sent chip). %>
  <%= tag.ul class: "flex flex-col gap-1 p-1", role: "list", aria: { label: searching? ? "Search results" : "Conversations" },
             data: { search: (true if searching?) } do %>
    <%= render partial: "common/messages/conversation_summary", collection: messages, as: :message,
               locals: { owner: message_owner, namespace: messages_route_prefix, folder:, selected_id:, **search_scope } %>
  <% end %>
<% end %>

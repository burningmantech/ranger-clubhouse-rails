<%# locals: (message:, folder:, reply_form:) %>
<%# The pane's body: the thread's header with its controls, the messages as
    cards, newest last, then the reply form or the callout that stands in for
    it. data-review-id is how review_pane_controller knows which row is open.

    Opened from a search, each card's body is drawn with the search's matches
    marked, and the thread lands on the card that stands for the hit
    (MessagesHelper#message_search_landing). The cards holding a match are what
    the stepper over them walks (search_matches_controller). %>
<% q = search_query %>
<% rows = message.thread_rows %>
<% bodies = rows.map { |row| message_body_marks(message_body(row), q) } %>
<% landing = message_search_landing(rows, bodies, q) %>
<%= tag.div data: { review_id: message.id, controller: ("search-matches" if landing) } do %>
  <%= turbo_frame_tag "messages-panel-header", class: "flex flex-wrap items-center gap-3 pb-3 mb-3 border-b border-line/25" do %>
    <%= render partial: "common/messages/messages_panel_header", locals: { message:, folder: } %>
  <% end %>

  <%# The stepper, on a row of its own over the messages and pinned 8px inside
      the top of whatever scrolls them -- the pane from lg, the page below it --
      so it is in reach however far down the reader goes. A card it lands on
      keeps clear of it (_message_card's scroll margin). %>
  <% if landing %>
    <% matches = message_search_matches(rows, bodies) %>
    <div class="sticky top-2 z-10 w-fit ms-auto mb-3 bg-base-100 rounded-field">
      <%= ui_match_stepper "search-matches", label: "Matches in this conversation",
                                             current: matches.index(landing) + 1, total: matches.size %>
    </div>
  <% end %>

  <%# Replies land here live (PersonMessage#announce_reply), on the
      owner's own page and on the Person and HQ pages viewing their mailbox.
      Where reading a thread marks it read (/me), one that lands while the page
      is on screen is marked read too (thread_live_controller, ruling D6),
      posting what the list beside the pane shows when it does, so the URL
      carries no folder or search of its own. A broadcast, a team message or a
      walk-up takes no reply, so it listens for none. %>
  <% live = message.accepts_replies? %>
  <%= turbo_stream_from message_owner, message, channel: MailboxStreamsChannel if live %>
  <%# A column, so each card can sit at its own side (_message_card). %>
  <%= tag.div id: "messages-thread", class: "flex flex-col gap-4 pb-4", role: "log", aria: { label: "Conversation", live: "polite" },
              data: ({ controller: "thread-live",
                       thread_live_url_value: mark_read_message_path(message) } if live && mark_read_on_view?) do %>
    <%= render partial: "common/messages/thread", locals: { message:, owner: message_owner, rows:, bodies:, landing: } %>
  <% end %>

  <div class="border-t border-line/25 pt-3">
    <%= turbo_frame_tag "messages-reply-form" do %>
      <% if message.accepts_replies? %>
        <%= render partial: "common/messages/reply_form", locals: { message:, reply_form: } %>
      <% else %>
        <%= ui_callout_box :secondary, icon: message_no_reply_icon(message), role: "status" do %>
          <% if message.from_rbs? %>
            <strong>Broadcast message.</strong> Sent by the <%= message.sender_name %>; it cannot be replied to.
          <% elsif message.from_team? %>
            <strong>Team message.</strong> Sent by the <%= message.sender_name %>; it cannot be replied to.
            <%# A team deleted since has no address (PersonMessage#sender_name names it by id). %>
            <% if message.sender_team&.email.present? %>
              <%# Team list addresses run to 50+ characters, wider than a phone's callout. %>
              Email them at <%= mail_to message.sender_team.email, nil, class: "wrap-anywhere" %>.
            <% end %>
          <% else %>
            <strong>No Clubhouse sender.</strong> The sender isn't linked to a Clubhouse account, so it cannot be replied to.
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<%# locals: (message:, owner:, q:) %>
<%# What #messages-thread holds: the expiry notice and the cards, newest last.
    Mark Read and Mark Unread morph the cards one by one
    (MessagesConcern#card_streams), never the whole of it, whose morph would
    remove a card that landed live after their request loaded the thread.

    Opened from a search (q), each body is drawn with the search's matches
    marked, and the thread lands on the card that stands for the hit
    (MessagesHelper#message_search_landing): ringed, and brought into view by
    the marker, which names the pane as the scroller to move from lg. Both are
    drawn here alone: review_pane_controller keeps them through the cards'
    read-state morphs, whose renders know no search. %>
<% rows = message.thread_rows %>
<% bodies = rows.map { |row| message_body_marks(message_body(row), q) } %>
<% landing = message_search_landing(rows, bodies, q) %>
<% if landing %>
  <div data-controller="scroll-to-element" data-scroll-to-element-id-value="<%= dom_id(landing, :card) %>"
       data-scroll-to-element-container-value=".review-pane" hidden></div>
<% end %>
<% if message.has_expired? %>
  <%= ui_callout_box :error do %>
    <strong>This message has expired.</strong> The information in it is no longer current.
  <% end %>
<% elsif message.expires_at.present? %>
  <%= ui_callout_box :warning, icon: "clock", icon_type: :regular, role: "status" do %>
    Expires <%= datetime_format message.expires_at %>
  <% end %>
<% end %>
<% rows.zip(bodies).each do |row, body| %>
  <%= render "common/messages/message_card", message: row, owner:, body:, landing: row == landing %>
<% end %>

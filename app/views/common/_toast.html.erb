<%# locals: (attrs:,toast_message:,countdown:,icon:,icon_type:) %>
<%= content_tag :div, attrs.merge({ "data-action": "mouseenter->toast#pause mouseleave->toast#resume" }) do %>
  <div class="inline-flex items-center justify-center shrink-0">
    <%= fa_icon icon, icon_type %>
  </div>
  <div class="ms-3 text-base font-normal w-full">
    <%= toast_message %>
  </div>
  <%= button_action "", :ghost, icon: "xmark", icon_type: :solid, class: "btn-circle",
                    aria: { label: "Close" }, data: { action: "click->toast#close" } %>
  <% if countdown %>
    <div class="toast-progress" data-toast-target="progress"></div>
  <% end %>
<% end %>


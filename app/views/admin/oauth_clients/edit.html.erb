<% content_for :title, "Edit Client" %>

<%# The stored id, not the typed one: a rejected form re-renders the record
    holding what was typed, and the heading names the client being edited. %>
<%= hero_panel icon: "key", heading_level: :h1, id: "oauth-client-form-header",
               title: "Edit #{@client.client_id_was}",
               description: "Change the Client ID, description, or secret this website uses.",
               back_to: ["OAuth Clients", admin_oauth_clients_path] %>

<%= render "form" %>

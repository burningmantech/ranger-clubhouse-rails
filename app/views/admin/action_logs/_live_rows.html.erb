<%# locals: (rows:) %>
<%# Shared by the page and ActionLogLiveChannel, so a streamed row cannot
    drift from the rows the page loaded with. The headings feed the fold's
    data-labels and are the ones _live draws. The five summary columns only:
    the Search mode has the detail row and the slot, position and team lines.
    The people are ActionLog.newest_first's narrow preload: id and callsign.
    The text style is set once on the list's body (_live), so a row carries
    only what differs per cell: every tick streams these. %>
<%= ui_table_rows headings: action_log_headings, striped: false do |t| %>
  <% rows.each do |row| %>
    <%= t.row id: "action-log-live-#{row.id}", align: :middle do %>
      <%= t.cell log_time_format(row.created_at), class: "whitespace-nowrap" %>
      <%= t.cell action_log_person_label(row.person_summary, row.person_id) %>
      <%= t.cell action_log_person_label(row.target_person_summary, row.target_person_id) %>
      <%= t.cell log_truncated(row.event), class: Admin::ActionLogsHelper::ACTION_LOG_EVENT_MAX_WIDTH %>
      <%= t.cell action_log_message_cell(row) %>
    <% end %>
  <% end %>
<% end %>

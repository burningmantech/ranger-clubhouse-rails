<%= hero_panel icon: "scroll", heading_level: :h1, id: "admin-action-logs-header",
               title: "Action Logs",
               description: "Search Action Log entries by person, time range, and event type, or watch new ones arrive." %>

<%# Two ways to read the log: search what was recorded, or watch it arrive.
    The mode showing is the filled button (log_mode_button). %>
<% live = !@live_logs.nil? %>
<%= button_row class: "my-4" do %>
  <%= log_mode_button "Search", icon: "magnifying-glass", url: admin_action_logs_path, current: !live %>
  <%= log_mode_button "Live", icon: "tower-broadcast", url: admin_action_logs_path(mode: "live"), current: live %>
<% end %>

<% if live %>
  <%= render "admin/action_logs/live", logs: @live_logs %>
<% else %>
<%= filter_bar id: "action-log-filters",
               chips: action_log_filter_chips(@form),
               clear_url: admin_action_logs_path,
               url: admin_action_logs_path, model: @form, scope: "filter" do |f| %>
  <%= form_row do %>
    <%= f.text_field :person_callsign,
                     label: "User Callsign",
                     maxlength: 64,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
    <%= f.text_field :target_person_callsign,
                     label: "Target Callsign",
                     maxlength: 64,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
  <% end %>

  <%= form_row do %>
    <%= f.datetime_field :start_time,
                         label: "Starts At",
                         width: "w-full",
                         wrapper_class: "flex-1" %>
    <%= f.datetime_field :end_time,
                         label: "Ends At",
                         width: "w-full",
                         wrapper_class: "flex-1" %>
  <% end %>

  <%= form_row do %>
    <%= f.text_field :event_name,
                     label: "Event Name",
                     maxlength: 30,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
    <%= f.text_field :message,
                     label: "Message",
                     width: "w-full",
                     wrapper_class: "flex-1" %>
  <% end %>

  <%= ui_disclosure "Event Categories",
                    variant: :card,
                    open: @form.event_filters.any?,
                    subtitle: @form.event_filters.any? ? "#{@form.event_filters.count} selected" : "Show event filter options" do %>
    <%# EVENT_FILTER_OPTIONS reads [label, value]; the grid takes [value, label].
        PARAM_SCOPE, not the form object's own name: these boxes stand outside
        the form builder, and the controller reads the search under filter[...]. %>
    <%= render "common/checkbox_grid",
               name: "#{ActionLogFilterForm::PARAM_SCOPE}[event_filters][]",
               options: ActionLogFilterForm::EVENT_FILTER_OPTIONS.map(&:reverse),
               selected: @form.event_filters,
               id_prefix: "action-log-event",
               align: :start %>
  <% end %>

  <%= button_row class: "mt-4" do %>
    <%= f.submit "Search" %>
  <% end %>
<% end %>

<%= ui_section "Action Log Entries", icon: "table-list", icon_type: :solid do %>
  <% pager = ui_pager(@pagy, summary: action_log_pager_summary(@result)) { |page| admin_action_logs_path(@form.query_params(page:)) } %>
  <% if @action_logs.empty? %>
    <%= ui_empty_state "No Action Log entries matched the current filters.", icon: "magnifying-glass", icon_type: :solid %>
    <% if @pagy.previous %>
      <div class="mt-4">
        <%= pager %>
      </div>
    <% end %>
  <% else %>
    <div class="mb-3">
      <%= pager %>
    </div>

    <%= render "admin/action_logs/table", rows: @action_logs %>

    <div class="mt-4">
      <%= pager %>
    </div>
  <% end %>
<% end %>
<% end %>

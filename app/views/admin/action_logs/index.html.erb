<%= hero_panel icon: "scroll", heading_level: :h1, id: "admin-action-logs-header",
               title: "Action Logs",
               description: "Review Action Log activity, inspect request metadata, and filter by people, time range, and event type." %>

<%= filter_bar id: "action-log-filters",
               chips: action_log_filter_chips(@form),
               clear_url: admin_action_logs_path,
               url: admin_action_logs_path, model: @form, scope: "filter" do |f| %>
  <%= form_row do %>
    <%= f.text_field :person_callsign,
                     label: "User Callsign",
                     maxlength: 64,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
    <%= f.text_field :target_person_callsign,
                     label: "Target Callsign",
                     maxlength: 64,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
  <% end %>

  <%= form_row do %>
    <%= f.datetime_field :start_time,
                         label: "Starts At",
                         width: "w-full",
                         wrapper_class: "flex-1" %>
    <%= f.datetime_field :end_time,
                         label: "Ends At",
                         width: "w-full",
                         wrapper_class: "flex-1" %>
  <% end %>

  <%= form_row do %>
    <%= f.text_field :event_name,
                     label: "Event Name",
                     maxlength: 30,
                     width: "w-full",
                     wrapper_class: "flex-1" %>
    <%= f.text_field :message,
                     label: "Message",
                     width: "w-full",
                     wrapper_class: "flex-1" %>
  <% end %>

  <%= ui_disclosure "Event Categories",
                    variant: :card,
                    open: @form.event_filters.any?,
                    subtitle: @form.event_filters.any? ? "#{@form.event_filters.count} selected" : "Show event filter options" do %>
    <%# EVENT_FILTER_OPTIONS reads [label, value]; the grid takes [value, label]. %>
    <%= render "common/checkbox_grid",
               name: "#{ActionLogFilterForm.model_name.param_key}[event_filters][]",
               options: ActionLogFilterForm::EVENT_FILTER_OPTIONS.map(&:reverse),
               selected: @form.event_filters,
               id_prefix: "action-log-event",
               align: :start %>
  <% end %>

  <%= button_row class: "mt-4" do %>
    <%= f.submit "Search" %>
  <% end %>
<% end %>

<%= ui_section "Action Log Entries", icon: "table-list", icon_type: :solid do %>
  <% pager = ui_pager(@meta, summary: action_log_pager_summary(@meta)) { |page| admin_action_logs_path(@form.query_params(page:)) } %>
  <% if @action_logs.empty? %>
    <%= ui_empty_state "No Action Log entries matched the current filters.", icon: "magnifying-glass", icon_type: :solid %>
    <% if @meta[:has_previous_page] %>
      <div class="mt-4">
        <%= pager %>
      </div>
    <% end %>
  <% else %>
    <div class="mb-3">
      <%= pager %>
    </div>

    <%= ui_table striped: false do |t| %>
      <%= t.header do %>
        <%= t.heading "Timestamp" %>
        <%= t.heading "User" %>
        <%= t.heading "Target Person" %>
        <%= t.heading "Event" %>
        <%= t.heading "Message" %>
      <% end %>
      <%= t.body do %>
        <% @action_logs.each do |row| %>
          <% detail_dom_id = "action-log-detail-#{row.id}" %>
          <% timestamp = log_time_format(row.created_at) %>
          <% collapsed_toggle_label = action_log_toggle_label(timestamp) %>
          <% expanded_toggle_label = action_log_toggle_label(timestamp, expanded: true) %>
          <% inline_metadata_lines = action_log_inline_metadata_lines(row) %>
          <%= t.row class: class_names("align-middle", "border-b-0": inline_metadata_lines.any?) do %>
            <%= t.cell class: "align-top" do %>
              <%= button_action collapsed_toggle_label, :ghost, controller: "toggle",
                                size: "sm",
                                class: "justify-start px-1 text-left normal-case",
                                aria: { controls: detail_dom_id, expanded: false },
                                data: {
                                  toggle_dom_id_value: detail_dom_id,
                                  toggle_label_value: expanded_toggle_label
                                } %>
            <% end %>
            <%= t.cell class: log_text_class("align-middle") do %>
              <%= action_log_person_label(row.person, row.person_id) %>
            <% end %>
            <%= t.cell class: log_text_class("align-middle") do %>
              <%= action_log_person_label(row.target_person, row.target_person_id) %>
            <% end %>
            <%= t.cell class: class_names("align-middle text-sm leading-snug", Admin::ActionLogsHelper::ACTION_LOG_EVENT_MAX_WIDTH) do %>
              <%= log_truncated(row.event) %>
            <% end %>
            <%= t.cell class: log_text_class("align-middle") do %>
              <%= action_log_message_cell(row) %>
            <% end %>
          <% end %>

          <% if inline_metadata_lines.any? %>
            <%= t.row do %>
              <%= t.cell colspan: 5, class: "pt-0" do %>
                <div class="action-log-inline-metadata space-y-1 text-sm leading-snug text-stone-muted">
                  <% inline_metadata_lines.each do |line| %>
                    <div><%= line %></div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% end %>

          <%= t.detail_row id: detail_dom_id do %>
            <div class="space-y-4 py-2">
              <div>
                <div class="<%= log_heading_class %>">Metadata</div>
                <%= ui_label_value label_width: "6rem" do |list| %>
                  <% action_log_metadata_items(row).each do |label, value| %>
                    <%= list.row label do %>
                      <%= value %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>

              <div>
                <div class="<%= log_heading_class %>">Data</div>
                <%= action_log_pretty_data_block(row) %>
              </div>

              <% if action_log_roles(row).any? %>
                <div>
                  <div class="<%= log_heading_class %>">Roles</div>
                  <div class="space-y-1">
                    <% action_log_roles(row).each do |role| %>
                      <div class="text-base text-body">Role #<%= role.id %> · <%= role.title %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <div class="mt-4">
      <%= pager %>
    </div>
  <% end %>
<% end %>

<%# locals: (person:) %>
<%= ui_section "Name & Contact",
               icon: "circle-user",
               icon_type: :solid,
               edit_link: (can_edit_profile? ? profile_edit_section_path("identity-info") : nil) do %>
  <div class="space-y-2">
    <div>
      <div class="text-lg font-semibold text-heading">
        <%= person.callsign %>
      </div>
      <% if person.callsign_pronounce.present? %>
        <div class="font-semibold text-stone-muted">
          "<%= person.callsign_pronounce %>"
        </div>
      <% end %>
    </div>

    <div>
      <div class="font-semibold text-stone-emphasis">Legal name</div>
      <div class="text-base text-heading">
        <%= person.first_name %> <%= person.mi %> <%= person.last_name %>
      </div>
    </div>

    <div class="text-base text-stone-muted">
      <% if person.preferred_name? %>
        Preferred name: <span class="font-semibold text-heading"><%= person.preferred_name %></span>
      <% else %>
        <span class="italic">no preferred first name given</span>
      <% end %>
    </div>

    <div class="flex flex-wrap gap-x-4 gap-y-1 text-base text-stone-muted">
      <div>
        <span class="font-semibold text-stone-emphasis">Gender:</span>
        <% if person.gender_not_stated? %>
          <span class="italic">not stated</span>
        <% else %>
          <%= gender_format person %>
        <% end %>
      </div>
      <div>
        <span class="font-semibold text-stone-emphasis">Pronouns:</span>
        <% if person.pronouns? %>
          <%= pronouns_format person %>
        <% else %>
          <span class="italic">not stated</span>
        <% end %>
      </div>
    </div>

    <% if can_view_contact_methods? %>
      <div class="text-base text-stone-emphasis">
        <div class="font-semibold text-stone-emphasis">Contact</div>
        <div class="text-stone-muted space-y-1">
          <div><%= person.email %></div>
          <div><%= phone_format(person.home_phone) %></div>
          <% if person.alt_phone.present? %>
            <div><%= phone_format(person.alt_phone) %> (alternative)</div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>

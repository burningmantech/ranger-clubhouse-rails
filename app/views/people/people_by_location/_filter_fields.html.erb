<%# The filter controls, shared by the countries index and the country pages so
    the two cannot drift apart.
    Locals: f (form builder). %>
<%= form_row do %>
  <%= f.select :participation, people_by_location_participation_options(@year),
               label: "Show", selected: @participation,
               width: "w-full", wrapper_class: "flex-1" %>
<% end %>

<%= f.fieldset "Also Include", class: "form-fieldset mt-3",
                aria: { describedby: "include-status-help" } do %>
  <p id="include-status-help" class="<%= AppFormBuilder::HELP_TEXT_CLASSES %>">
    People who are not Rangers right now are hidden until you ask for them.
  </p>
  <%= render "common/checkbox_grid",
             name: "statuses[]",
             options: PeopleByLocationReport::OPTIONAL_STATUSES.map { |status|
               [status, status]
             },
             selected: @statuses,
             id_prefix: "include-status" %>
<% end %>

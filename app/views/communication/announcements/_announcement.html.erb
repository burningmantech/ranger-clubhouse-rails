<%# locals: (announcement:) %>
<%
  expired = announcement.expired?
  # An expired announcement is still listed, but it is no longer being shown to
  # anyone, so it recedes.
  card_class = "mb-3 p-4 #{"opacity-70" if expired}"
%>
<%= ui_card id: "announcement-#{announcement.id}", class: card_class, role: "article" do %>
  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-2">
    <h2 class="inline-flex-center-gap-2 heading-section text-heading">
      <%= fa_icon expired ? "clock" : "bullhorn", :solid, class: "text-stone-icon", fixed: true %>
      <%= announcement.subject %>
    </h2>
    <div class="shrink-0">
      <%= announcement_status_badge(announcement) %>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-subtle my-2">
    <span class="inline-flex-center-gap-2">
      <%= fa_icon "user", :regular %>
      <%# Announcement Management does not open person pages, so the callsign
          links only for readers who can follow it. %>
      Posted by <%= person_display_link(announcement.person, announcement.person_id) %>
    </span>
    <span class="inline-flex-center-gap-2">
      <%= fa_icon "calendar", :regular %>
      <%= safe_join(["Posted", datetime_format(announcement.created_at, year: true)], " ") %>
    </span>
    <span class="inline-flex-center-gap-2">
      <%= fa_icon "hourglass-half", :solid %>
      <%= safe_join([expired ? "Expired" : "Expires",
                     datetime_format(announcement.expires_at, year: true)], " ") %>
    </span>
    <span class="inline-flex-center-gap-2">
      <%= fa_icon "users", :solid %>
      <%= announcement.audience_labels.to_sentence %>
    </span>
  </div>

  <%# Tall announcements scroll inside the card rather than pushing the next one
      off the screen. %>
  <div class="lexxy-content text-body bg-default rounded-base border border-line p-3 max-h-64 overflow-y-auto">
    <%= rich_text(announcement.message) %>
  </div>

  <div class="pt-3 mt-3 border-t border-line">
    <%= button_row do %>
      <%= edit_link edit_communication_announcement_path(announcement), "Edit",
                    aria: { label: "Edit #{announcement.subject}" } %>
      <%= delete_button communication_announcement_path(announcement),
                        confirm_modal: {
                          title: "Confirm Announcement Deletion",
                          # The subject goes in as text only. strip_tags escapes as it
                          # strips and the confirmation escapes again, so an "&" would
                          # reach the reader as "&amp;" -- undo the stripper's escaping
                          # and let the confirmation do it once.
                          message: "Delete the announcement \"#{CGI.unescapeHTML(strip_tags(announcement.subject))}\"? This cannot be undone.",
                          confirm_label: "Delete Announcement",
                          method: :delete
                        } %>
    <% end %>
  </div>
<% end %>

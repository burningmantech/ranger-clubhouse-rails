<%# locals: (f:) %>
<%# Who the broadcast goes to. Every choice here narrows the list of people the
    next page shows. %>
<%= ui_section "Who Receives It", icon: "users", icon_type: :solid do %>
  <% if @form.picks_alert? %>
    <%= f.select :alert_id, rbs_alert_options(@alerts),
                 { label: "Alert Type", include_blank: "Choose an alert type…", required: true,
                   help_text: "Rangers choose which alert types they receive on their Alert Preferences page." },
                 { class: "w-full lg:w-96" } %>
  <% end %>

  <% if @form.has_slot? %>
    <div class="mt-3 pt-3 border-t border-line">
      <dl class="instruction-list mb-3">
        <dt>How do I find the shift?</dt>
        <dd>Choose its position first; the shifts of that position with sign-ups are then listed.</dd>
      </dl>
      <%= f.select :slot_position_id,
                   options_for_select(@slot_positions.map { |id, title| [title, id] }, @form.slot_position_id),
                   { label: "Position", include_blank: "Choose a position…" },
                   { class: "w-full lg:w-96", data: { action: "change->form#submit" } } %>

      <% if @slots.any? %>
        <%= f.select :slot_id,
                     options_for_select(@slots.map { |slot| [rbs_slot_label(slot), slot.id] }, @form.slot_id),
                     { label: "Shift", include_blank: "Choose a shift…", required: true },
                     { class: "w-full" } %>
      <% elsif @form.slot_position_id.present? %>
        <%= ui_empty_state "That position has no shifts with sign-ups this year.",
                           icon: "calendar-xmark", icon_type: :solid %>
      <% end %>
    </div>
  <% end %>

  <% if @form.has_status? %>
    <div class="mt-3 pt-3 border-t border-line">
      <label class="<%= AppFormBuilder::LABEL_CLASSES %>" id="broadcast-statuses-label">Account status</label>
      <div role="group" aria-labelledby="broadcast-statuses-label">
        <%# Sent whatever the boxes say, so clearing them all reads as a choice
            rather than as a form that was never filled in. %>
        <%= hidden_field_tag "#{RbsBroadcastForm::PARAM_SCOPE}[statuses][]", "", id: nil %>
        <%= render "common/checkbox_grid",
                   name: "#{RbsBroadcastForm::PARAM_SCOPE}[statuses][]",
                   options: rbs_status_options, selected: @form.statuses, id_prefix: "broadcast-status" %>
      </div>
      <p class="text-sm text-stone-subtle mt-1">
        Statuses that never receive Clubhouse messages are not offered.
      </p>
    </div>
  <% end %>

  <% if @form.has_position? %>
    <div class="mt-4 pt-3 border-t border-line">
      <%= render "position_checkboxes", selected: @form.position_ids %>
      <div class="mt-3">
        <%= f.collection_radio_buttons :position_signed_up, rbs_signed_up_options, :last, :first,
                                       { label: "Shift Sign-Ups" } %>
      </div>
    </div>
  <% end %>

  <% if @form.has_restrictions? %>
    <div class="mt-4 pt-3 border-t border-line">
      <span class="<%= AppFormBuilder::LABEL_CLASSES %>" id="broadcast-attendance-label">Attendance</span>
      <div role="group" aria-labelledby="broadcast-attendance-label">
        <%= f.check_box :on_site, inline_label: "Signed up for any shift during the event, or has said they are here" %>
        <%= f.check_box :attending, inline_label: "Signed up for anything at all this year" %>
      </div>
      <div class="mt-3">
        <%= f.collection_radio_buttons :training, rbs_training_options, :last, :first,
                                       { label: "In-Person Training" } %>
      </div>
    </div>
  <% end %>
<% end %>
